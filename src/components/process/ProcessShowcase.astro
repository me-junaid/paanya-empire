---
---

<!-- 8. PROCESS IN ACTION (DELIVERED MILESTONES) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-outline-variant/30 pb-4">
    <div class="flex flex-col gap-1">
      <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
        Delivered Milestones
      </span>
      <h2 class="font-headline text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-on-surface">
        Process In Action
      </h2>
    </div>
    <a 
      href="/projects" 
      class="inline-flex items-center gap-1.5 text-xs font-bold text-primary tracking-wider uppercase hover:text-primary-container transition-colors"
    >
      <span>Explore All Projects</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {[
      {
        image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80',
        badge: 'Turnkey Execution',
        title: 'The Obsidian Villa',
        slug: 'the-obsidian-villa',
        desc: 'Delivered 14 days ahead of scheduled timeline with zero punch-list snags and pristine monolithic stone execution.'
      },
      {
        image: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80',
        badge: 'Structural Overhaul',
        title: 'Aura Horizon Duplex',
        slug: 'aura-horizon-duplex',
        desc: 'Complete seismic retrofitting, post-tensioned slabs, and double-height architectural glass installation.'
      },
      {
        image: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&q=80',
        badge: 'Full Build Cycle',
        title: 'The Glass Pavilion',
        slug: 'the-glass-pavilion',
        desc: 'From raw plot environmental sanction to bespoke luxury interior key delivery in exactly 11 months.'
      }
    ].map((proj) => (
      <a 
        href={`/projects/${proj.slug}`}
        class="group flex flex-col rounded-2xl overflow-hidden bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/40 hover:shadow-md transition-all"
      >
        <div class="relative w-full h-52 overflow-hidden bg-cover bg-center">
          <img 
            src={proj.image} 
            alt={proj.title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-[10px] font-bold uppercase tracking-wider text-primary">
            {proj.badge}
          </span>
        </div>

        <div class="p-5 flex flex-col justify-between flex-1 gap-3">
          <div class="flex flex-col gap-1">
            <h3 class="font-headline text-base font-bold uppercase text-on-surface group-hover:text-primary transition-colors tracking-tight">
              {proj.title}
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              {proj.desc}
            </p>
          </div>

          <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary uppercase tracking-wider mt-2">
            <span>Case Study</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
