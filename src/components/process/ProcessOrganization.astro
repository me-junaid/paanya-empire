<!-- 6. ONE TEAM COORDINATION MODEL (ORGANIZATIONAL ARCHITECTURE) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-3xl bg-[#071A33] text-on-primary p-6 sm:p-12 border border-white/10 shadow-xl flex flex-col gap-10 items-center text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/10 via-transparent to-primary/10 pointer-events-none"></div>
    
    <div class="flex flex-col gap-3 items-center max-w-xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 text-primary-fixed text-[11px] font-bold tracking-[0.2em] uppercase backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-container animate-pulse"></span>
        Organizational Architecture
      </div>
      
      <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-white leading-tight">
        One Team. One Responsibility.
      </h2>
      
      <p class="text-xs sm:text-sm text-surface-container-high leading-relaxed font-light">
        Eliminating the costly communication gaps, scope variances, and finger-pointing typical between isolated designers and independent builders.
      </p>
    </div>

    <!-- Hub Visual Diagram -->
    <div class="w-full max-w-2xl bg-white/5 border border-white/10 p-6 sm:p-8 rounded-2xl backdrop-blur-md flex flex-col items-center gap-6 relative z-10 shadow-md">
      <!-- Client Node -->
      <div class="px-6 py-2.5 rounded-full bg-white text-on-surface text-xs font-bold tracking-wider uppercase shadow-md flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        YOU (THE CLIENT)
      </div>

      <!-- Connector Arrow -->
      <div class="flex flex-col items-center gap-1 text-primary-fixed">
        <span class="text-[10px] font-bold tracking-widest uppercase text-secondary-fixed">Direct Unified Channel</span>
        <svg class="w-4 h-4 text-primary-fixed animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>

      <!-- Central Anchor Node -->
      <div class="px-8 py-3.5 rounded-xl bg-primary text-on-primary text-xs sm:text-sm font-bold tracking-widest uppercase shadow-xl flex items-center gap-2.5">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        PAANYA CENTRAL ANCHOR
      </div>

      <!-- Connector Line -->
      <div class="w-full max-w-md h-[1px] bg-white/20 my-1"></div>

      <!-- Spokes Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 w-full text-center">
        {[
          'Architectural BIM',
          'Civil Engineering',
          'Site Supervision',
          'MEP Infrastructure',
          'Bespoke Millwork',
          'Quality Auditing'
        ].map((spoke) => (
          <div class="bg-white/10 p-3 rounded-xl text-xs font-semibold text-surface-container-high border border-white/5 hover:border-primary-fixed/40 transition-colors">
            {spoke}
          </div>
        ))}
      </div>
    </div>

    <p class="text-xs sm:text-sm text-surface-container-high font-light italic max-w-md relative z-10">
      "No subcontractor finger-pointing. When Paanya takes the build, the build is guaranteed."
    </p>
  </div>
</section>
