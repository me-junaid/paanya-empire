---

<!-- 2. PROCESS INTRODUCTION (HOW IT WORKS) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-10">
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
        How It Works
      </span>
      <div class="h-0.5 w-8 bg-primary/30"></div>
    </div>
    
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      You Have The Vision. We Manage The Journey.
    </h2>
    
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Building bespoke architecture requires navigating hundreds of high-stakes technical decisions. We consolidate the entire operational apparatus under one disciplined protocol, eliminating finger-pointing, scheduling lags, and compounding cost overruns.
    </p>
  </div>

  <!-- 5-Phase Sequence Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    {[
      { num: '01', title: 'DESIGN', desc: 'Concept, spatial flow & 3D BIM visualization' },
      { num: '02', title: 'PLAN', desc: 'Soil engineering, BOQ estimation & permits' },
      { num: '03', title: 'BUILD', desc: 'Substructure, concrete frame & masonry' },
      { num: '04', title: 'FINISH', desc: 'MEP testing, custom joinery & surface detailing' },
      { num: '05', title: 'HANDOVER', desc: '240-point audit, warranty dossier & key delivery' }
    ].map((phase) => (
      <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between gap-3 hover:border-primary/40 hover:shadow-xs transition-all">
        <span class="w-8 h-8 rounded-lg bg-surface-container-highest text-primary font-headline font-bold text-xs flex items-center justify-center">
          {phase.num}
        </span>
        <div class="flex flex-col gap-1">
          <h4 class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface">
            {phase.title}
          </h4>
          <p class="text-[11px] text-on-surface-variant leading-relaxed">
            {phase.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
