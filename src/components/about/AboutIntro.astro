<!-- 2. COMPANY INTRODUCTION (WHO WE ARE) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-7 flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
          Who We Are
        </span>
        <div class="h-0.5 w-8 bg-primary/30"></div>
      </div>

      <h2 class="font-headline text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-on-surface leading-tight">
        More Than A Construction Company.<br />
        <span class="text-primary">Your Complete Project Partner.</span>
      </h2>

      <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed font-normal">
        At Paanya Empire, we remove the friction of fragmented building execution. By uniting architectural planning, technical engineering, civil construction, interior design, and rigorous quality inspection under a single integrated banner, our clients receive a cohesive journey free from finger-pointing and hidden compromises.
      </p>

      <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed font-normal">
        We serve discerning homeowners, luxury property investors, and commercial developers seeking uncompromising precision, guaranteed timelines, and clear, honest communication at every phase of development.
      </p>
    </div>

    <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
      <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col gap-2 hover:border-primary/40 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-surface-container text-primary flex items-center justify-center mb-1">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="font-headline font-bold text-xs uppercase text-on-surface tracking-wider">
          Single-Point Accountability
        </span>
        <span class="text-xs text-on-surface-variant leading-relaxed">
          Total operational ownership from the initial feasibility study and municipal sanction to certified final occupancy.
        </span>
      </div>

      <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col gap-2 hover:border-primary/40 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-surface-container text-primary flex items-center justify-center mb-1">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
          </svg>
        </div>
        <span class="font-headline font-bold text-xs uppercase text-on-surface tracking-wider">
          Bespoke Craftsmanship
        </span>
        <span class="text-xs text-on-surface-variant leading-relaxed">
          Precision structural engineering and artisanal joinery tailored to site microclimate, orientation, and lifestyle.
        </span>
      </div>
    </div>
  </div>
</section>
