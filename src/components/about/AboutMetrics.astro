<!-- 10. COMPANY METRICS & EDITORIAL PHILOSOPHY -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-12">
  <!-- Micro Architectural Metrics Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    {[
      { value: '48+', label: 'Projects Completed', sub: 'Residential & Commercial' },
      { value: '18+', label: 'Years Experience', sub: 'Engineering & Construction' },
      { value: '65+', label: 'In-House Specialists', sub: 'Architects & Engineers' },
      { value: '04', label: 'Metropolitan Regions', sub: 'Active Site Footprint' }
    ].map((metric) => (
      <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col items-center text-center justify-center gap-1 hover:border-primary/40 transition-colors">
        <span class="font-headline text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
          {metric.value}
        </span>
        <span class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface mt-1">
          {metric.label}
        </span>
        <span class="text-[10px] text-on-surface-variant font-medium">
          {metric.sub}
        </span>
      </div>
    ))}
  </div>

  <!-- Editorial Reflection Banner -->
  <div class="rounded-3xl bg-[#071A33] text-white p-8 sm:p-14 text-center flex flex-col items-center justify-center border border-white/10 shadow-lg relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/10 via-transparent to-primary/10 pointer-events-none"></div>
    <span class="text-primary-fixed tracking-[0.25em] text-[10px] font-bold uppercase mb-4">
      Editorial Reflection
    </span>
    <blockquote class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase leading-snug tracking-tight max-w-2xl text-white">
      "Good building isn't just about what you see. It's about everything that happens before it."
    </blockquote>
    <div class="h-0.5 w-12 bg-primary my-6"></div>
    <p class="text-xs sm:text-sm text-surface-container-high leading-relaxed font-light max-w-md">
      Planning, coordination, material integrity, and relentless attention to detail shape the lasting legacy of a built environment.
    </p>
  </div>
</section>
