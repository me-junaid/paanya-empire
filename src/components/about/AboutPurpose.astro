<!-- 4. WHY PAANYA EMPIRE EXISTS (OUR PURPOSE) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-10">
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
        Our Purpose
      </span>
      <div class="h-0.5 w-8 bg-primary/30"></div>
    </div>
    
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      Construction Should Feel Simpler For The Client.
    </h2>
    
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Building a bespoke residence or commercial development involves hundreds of technical decisions, permits, contractors, and moving parts. Our purpose is to bring those disparate elements into one harmonized, calm experience.
    </p>
  </div>

  <!-- Comparison Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Without Turnkey Partner -->
    <div class="p-6 sm:p-8 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between gap-6">
      <div class="flex flex-col gap-4">
        <div class="inline-flex items-center gap-1.5 self-start px-3 py-1 rounded-full bg-error-container text-on-error-container font-semibold text-[10px] tracking-wider uppercase">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Without A Turnkey Partner
        </div>

        <h3 class="font-headline text-lg font-bold text-on-surface uppercase tracking-tight">
          Fragmented Trades &amp; Shared Blame
        </h3>

        <div class="flex flex-col gap-3 text-xs text-on-surface-variant">
          <div class="flex items-start gap-2.5">
            <span class="text-error font-bold mt-0.5">•</span>
            <span>Disconnected architects, civil teams, plumbers, and sub-contractors operating in silos</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-error font-bold mt-0.5">•</span>
            <span>Multiple conflicting points of contact leading to finger-pointing and schedule slips</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-error font-bold mt-0.5">•</span>
            <span>Frequent budget creep, unquoted variance orders, and opaque billing surprises</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-error font-bold mt-0.5">•</span>
            <span>The client ends up acting as the full-time unpaid site coordinator and dispute mediator</span>
          </div>
        </div>
      </div>
    </div>

    <!-- With Paanya Empire -->
    <div class="p-6 sm:p-8 rounded-2xl bg-[#071A33] text-on-primary border-2 border-primary/40 shadow-md flex flex-col justify-between gap-6 relative overflow-hidden">
      <div class="flex flex-col gap-4 relative z-10">
        <div class="inline-flex items-center gap-1.5 self-start px-3 py-1 rounded-full bg-primary text-on-primary font-semibold text-[10px] tracking-wider uppercase">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          With Paanya Empire
        </div>

        <h3 class="font-headline text-lg font-bold text-primary-fixed uppercase tracking-tight">
          One Team. One Responsibility. One Complete Project.
        </h3>

        <div class="flex flex-col gap-3 text-xs text-surface-container-high">
          <div class="flex items-start gap-2.5">
            <span class="text-primary-container font-bold mt-0.5">•</span>
            <span class="text-white font-medium">Single accountable contract backed by dedicated executive project leadership</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-primary-container font-bold mt-0.5">•</span>
            <span>Fully synchronized in-house architects, structural engineers, and site managers</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-primary-container font-bold mt-0.5">•</span>
            <span>Strictly guarded critical-path milestones and transparent fixed-price cost controls</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-primary-container font-bold mt-0.5">•</span>
            <span>Calm, guided experience with weekly high-resolution photographic and video reporting</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
