<!-- 7. END-TO-END CAPABILITY (Deep Navy Full-Width Interactive Milestones) -->
<section class="w-full py-16 sm:py-24 bg-inverse-surface text-inverse-on-surface">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="max-w-2xl mb-10 sm:mb-16">
      <span class="font-label text-xs font-bold tracking-[0.24em] text-inverse-primary uppercase mb-2 sm:mb-3 block">ONE COMPLETE JOURNEY</span>
      <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-bold text-on-primary tracking-tight">
        FROM CONCEPT TO HANDOVER.
      </h2>
      <p class="text-outline-variant mt-2 sm:mt-3 text-xs sm:text-sm">
        A seamless 9-stage operational sequence that eliminates gaps between vision and realization.
      </p>
    </div>
    
    <!-- Desktop Sequential Milestone Rail -->
    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-9 gap-3 sm:gap-4 relative">
      <div class="p-4 rounded-lg bg-surface-container-lowest/5 backdrop-blur-sm flex flex-col justify-between hover:bg-surface-container-lowest/10 transition-colors">
        <span class="font-label text-[10px] sm:text-xs font-bold text-inverse-primary mb-3 sm:mb-4">STAGE 01</span>
        <div>
          <h4 class="font-headline font-semibold text-xs tracking-wider uppercase text-on-primary mb-1">Consultation</h4>
          <p class="text-[10px] sm:text-[11px] text-outline-variant">Initial vision mapping &amp; brief</p>
        </div>
      </div>
      
      <div class="p-4 rounded-lg bg-surface-container-lowest/5 backdrop-blur-sm flex flex-col justify-between hover:bg-surface-container-lowest/10 transition-colors">
        <span class="font-label text-[10px] sm:text-xs font-bold text-inverse-primary mb-3 sm:mb-4">STAGE 02</span>
        <div>
          <h4 class="font-headline font-semibold text-xs tracking-wider uppercase text-on-primary mb-1">Site Analysis</h4>
          <p class="text-[10px] sm:text-[11px] text-outline-variant">Topography &amp; soil testing</p>
        </div>
      </div>
      
      <div class="p-4 rounded-lg bg-surface-container-lowest/5 backdrop-blur-sm flex flex-col justify-between hover:bg-surface-container-lowest/10 transition-colors">
        <span class="font-label text-[10px] sm:text-xs font-bold text-inverse-primary mb-3 sm:mb-4">STAGE 03</span>
        <div>
          <h4 class="font-headline font-semibold text-xs tracking-wider uppercase text-on-primary mb-1">Architecture</h4>
          <p class="text-[10px] sm:text-[11px] text-outline-variant">Schematic 3D &amp; floorplans</p>
        </div>
      </div>
      
      <div class="p-4 rounded-lg bg-surface-container-lowest/5 backdrop-blur-sm flex flex-col justify-between hover:bg-surface-container-lowest/10 transition-colors">
        <span class="font-label text-[10px] sm:text-xs font-bold text-inverse-primary mb-3 sm:mb-4">STAGE 04</span>
        <div>
          <h4 class="font-headline font-semibold text-xs tracking-wider uppercase text-on-primary mb-1">Estimation</h4>
          <p class="text-[10px] sm:text-[11px] text-outline-variant">Fixed line-item budgeting</p>
        </div>
      </div>
      
      <div class="p-4 rounded-lg bg-surface-container-lowest/5 backdrop-blur-sm flex flex-col justify-between hover:bg-surface-container-lowest/10 transition-colors">
