---
---

<!-- 3. OUR APPROACH -->
<section class="w-full bg-surface-container-low border-y border-outline-variant/20 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col gap-10">
    <!-- Visual Architectural Banner -->
    <div class="relative w-full h-64 sm:h-80 rounded-2xl overflow-hidden shadow-sm">
      <img 
        src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80" 
        alt="Architectural execution" 
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#071A33]/90 via-[#071A33]/40 to-transparent"></div>
      
      <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-1 text-on-primary">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest/15 backdrop-blur-md self-start text-[10px] font-bold uppercase tracking-widest text-primary-fixed">
          Continuous Execution Cycle
        </span>
        <h3 class="font-headline text-xl sm:text-2xl font-bold uppercase tracking-tight text-white mt-1">
          From Concept Validation To Finished Key Handover
        </h3>
      </div>
    </div>

    <!-- Section Header & 4-Step Methodology -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
          Our Approach
        </span>
        <div class="h-0.5 w-8 bg-primary/30"></div>
      </div>
      
      <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
        From An Idea To A Completed Space.
      </h2>
      
      <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
        Every project begins with understanding the client's requirements, lifestyle, site constraints, and vision. From there, our synchronized team coordinates the planning, engineering, execution, and finishing required to turn that vision into a landmark build.
      </p>
    </div>

    <!-- 4-Step Progression Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        {
          num: '01',
          title: 'UNDERSTAND',
          desc: 'Deep dive into client lifestyle brief, site topography, zoning sanctions, soil hydrology, and aesthetic intent.'
        },
        {
          num: '02',
          title: 'PLAN',
          desc: 'Develop detailed architectural schematics, structural load models, itemized BOQs, and logistical critical-path sequencing.'
        },
        {
          num: '03',
          title: 'BUILD',
          desc: 'Coordinate continuous on-site construction with rigorous concrete batch testing, MEP integrations, and weekly photo logs.'
        },
        {
          num: '04',
          title: 'COMPLETE',
          desc: 'Manage artisanal interior millwork, 240-point snag inspection, occupancy compliance, and official key handover.'
        }
      ].map((step) => (
        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 shadow-xs flex flex-col justify-between gap-4 hover:border-primary/40 hover:shadow-md transition-all">
          <div class="flex flex-col gap-3">
            <span class="w-10 h-10 rounded-xl bg-primary/10 text-primary font-headline font-bold text-sm flex items-center justify-center">
              {step.num}
            </span>
            <h4 class="font-headline text-sm font-bold uppercase tracking-wider text-on-surface">
              {step.title}
            </h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
