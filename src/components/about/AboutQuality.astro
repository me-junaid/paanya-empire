<!-- 9. QUALITY & PROJECT MANAGEMENT (Split Screen Execution Precision) -->
<section class="w-full py-16 sm:py-24 bg-surface-container-low">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <!-- Left Photography -->
      <div class="lg:col-span-6 relative rounded-xl overflow-hidden shadow-xl group">
        <div class="aspect-[4/3] w-full bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDA_U-UeI-xf4WXuesz1CrqIxBFJDHq0qlbT-1yXosccCPcf1EhpTIG2n_txM3II_X1SScxgNBqd0iFz0AkxxTDaRWJBsFBPK4PiTuxB6GhpHR54Qc_fZU9RStNUHgL3oxAp7kh4NDp4q3_TepkzQgdn4l-xBZTSVybbv-1OETl-h686SWLgSjRVKTyjRR3IxPi_-70_0gWsXtGcsVe12r3XIQVYui4rCNSmRGgMq54u5t4_zI-V4yUPw')"></div>
