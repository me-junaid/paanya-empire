<!-- 3. COMPANY INTRODUCTION (12-Column Asymmetric Grid & 8 Disciplines) -->
<section class="w-full py-16 sm:py-24 bg-surface">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Left: Who We Are -->
      <div class="lg:col-span-5 flex flex-col">
        <span class="font-label text-xs font-bold tracking-[0.24em] text-primary uppercase mb-3">WHO WE ARE</span>
        <h2 class="font-headline text-2xl sm:text-3xl lg:text-[42px] font-bold text-on-surface leading-[1.14] tracking-tight">
          MORE THAN A CONSTRUCTION COMPANY. YOUR COMPLETE PROJECT PARTNER.
        </h2>
        <div class="w-16 h-1 bg-primary mt-6 rounded-full"></div>
      </div>
      
      <!-- Right: Editorial narrative & 8 Disciplines -->
      <div class="lg:col-span-7 flex flex-col pt-2">
        <p class="font-body text-base sm:text-lg text-on-surface-variant leading-relaxed mb-6 sm:mb-8">
          At Paanya Empire, we systematically remove the friction of fragmented building execution. By uniting architectural planning, technical engineering, civil construction, interior design, and rigorous quality inspection under a single integrated banner, our clients receive a cohesive journey free from finger-pointing and hidden compromises.
        </p>
        <p class="font-body text-sm sm:text-base text-outline leading-relaxed mb-8 sm:mb-12">
          Traditional construction forces clients to broker conflicting contracts between disconnected architects, general contractors, engineers, and artisans. Paanya Empire replaces that complexity with total accountability, ensuring that pure architectural design intent translates precisely into physical form.
        </p>
        
        <!-- 8 Integrated Disciplines Mosaic -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-4 sm:pt-6 border-t border-outline-variant/30">
          <div class="p-3.5 sm:p-4 rounded-lg bg-surface-container flex flex-col group hover:bg-surface-container-high transition-colors">
            <span class="font-label text-[10px] sm:text-[11px] font-bold text-primary tracking-wider mb-1">01</span>
            <span class="font-headline text-xs font-semibold uppercase tracking-wider text-on-surface">Design</span>
          </div>
          <div class="p-3.5 sm:p-4 rounded-lg bg-surface-container flex flex-col group hover:bg-surface-container-high transition-colors">
            <span class="font-label text-[10px] sm:text-[11px] font-bold text-primary tracking-wider mb-1">02</span>
            <span class="font-headline text-xs font-semibold uppercase tracking-wider text-on-surface">Planning</span>
          </div>
          <div class="p-3.5 sm:p-4 rounded-lg bg-surface-container flex flex-col group hover:bg-surface-container-high transition-colors">
            <span class="font-label text-[10px] sm:text-[11px] font-bold text-primary tracking-wider mb-1">03</span>
            <span class="font-headline text-xs font-semibold uppercase tracking-wider text-on-surface">Construction</span>
          </div>
          <div class="p-3.5 sm:p-4 rounded-lg bg-surface-container flex flex-col group hover:bg-surface-container-high transition-colors">
            <span class="font-label text-[10px] sm:text-[11px] font-bold text-primary tracking-wider mb-1">04</span>
            <span class="font-headline text-xs font-semibold uppercase tracking-wider text-on-surface">Engineering</span>
