          <div class="p-3.5 sm:p-4 rounded-lg bg-surface-container flex flex-col group hover:bg-surface-container-high transition-colors">
            <span class="font-label text-[10px] sm:text-[11px] font-bold text-primary tracking-wider mb-1">05</span>
            <span class="font-headline text-xs font-semibold uppercase tracking-wider text-on-surface">Interiors</span>
