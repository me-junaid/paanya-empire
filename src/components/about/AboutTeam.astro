---
---

<!-- 7. THE TEAM BEHIND THE PROJECT -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-10">
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
        The Team Behind The Project
      </span>
      <div class="h-0.5 w-8 bg-primary/30"></div>
    </div>
    
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      People, Expertise And Coordination.
    </h2>
    
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Great architecture demands more than digital CAD files; it requires experienced site directors, structural engineers, and master craftsmen working in absolute harmony.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Featured Active Field Supervision Photo -->
    <div class="lg:col-span-5 relative h-80 sm:h-96 rounded-2xl overflow-hidden shadow-sm border border-outline-variant/30">
      <img 
        src="https://images.unsplash.com/photo-1541888086925-0c13e4b33c5e?auto=format&fit=crop&q=80" 
        alt="Field Engineers Reviewing Blueprints on Active Site"
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
      
      <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-black/60 backdrop-blur-md text-white text-[11px] uppercase tracking-wider font-medium flex justify-between items-center border border-white/10">
        <span class="font-bold text-white">Active Field Supervision</span>
        <span class="text-primary-fixed">Metropolis Project Site</span>
      </div>
    </div>

    <!-- Professional Roles Grid -->
    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {[
        {
          discipline: 'DESIGN',
          title: 'Principal Design Lead',
          role: 'Architectural Direction',
          desc: '14+ years commanding high-end residential masterplanning, spatial geometry, and bespoke estate elevation.'
        },
        {
          discipline: 'STRUCTURE',
          title: 'Chief Structural Engineer',
          role: 'Civil Systems & Load Integrity',
          desc: 'Specialist in seismic-resilient reinforced frames, deep pile foundations, and cantilevered load calculations.'
        },
        {
          discipline: 'OPERATIONS',
          title: 'Turnkey Project Director',
          role: 'Execution & Schedule Control',
          desc: 'Master orchestrator safeguarding critical path timelines, procurement schedules, and on-site trade coordination.'
        },
        {
          discipline: 'INTERIORS',
          title: 'Lead Interior Architect',
          role: 'Materials & Spatial Detailing',
          desc: 'Curator of European natural stone, acoustic wall geometries, custom architectural millwork, and lighting.'
        }
      ].map((member) => (
        <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between gap-3 hover:border-primary/40 hover:shadow-xs transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-primary tracking-widest uppercase font-headline">
              {member.discipline}
            </span>
            <span class="w-2 h-2 rounded-full bg-primary/40"></span>
          </div>

          <div class="flex flex-col gap-0.5">
            <h4 class="font-headline text-sm font-bold text-on-surface uppercase tracking-tight">
              {member.title}
            </h4>
            <span class="text-xs text-secondary font-medium">
              {member.role}
            </span>
          </div>

          <p class="text-xs text-on-surface-variant leading-relaxed">
            {member.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
