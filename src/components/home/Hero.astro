---
// Paanya Empire — Pinned Scroll-Driven Architectural Hero Animation
// Apple-class smooth scroll engine with frame-rate independent exponential decay
---

<section 
  id="hero-scroll-container" 
  class="hero-scroll-container relative w-full min-h-[260vh] md:min-h-[320vh] bg-[#050e1a]"
  aria-label="Paanya Empire Flagship Architectural Showcase"
>
  <!-- Pinned / Sticky Viewport -->
  <div 
    id="hero-sticky-frame" 
    class="hero-sticky-frame sticky top-20 h-[calc(100dvh-5rem)] w-full overflow-hidden bg-[#050e1a] flex items-center justify-center select-none"
  >
    <!-- Instant First-Frame Fallback (Behind canvas — guarantees 0ms paint, zero flicker) -->
    <img 
      id="hero-fallback-img" 
      src="/paanya-landing-page-animation/frame_001.jpg" 
      alt="Paanya Empire Luxury Villa - The Obsidian" 
      class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Hardware-Accelerated 2D Frame Canvas (starts invisible — revealed after first paint) -->
    <canvas 
      id="hero-frame-canvas" 
      class="absolute inset-0 w-full h-full block z-[1] cursor-default touch-none"
      style="opacity: 0; transition: opacity 0.45s ease-out; will-change: opacity;"
      aria-hidden="true"
    ></canvas>

    <!-- Architectural Cinematic Gradient Overlays -->
    <!-- Dark Vignette for Text Legibility (fades dynamically on scroll) -->
    <div 
      id="hero-overlay-dark" 
      class="absolute inset-0 z-10 pointer-events-none bg-gradient-to-t from-black/85 via-black/45 to-black/35 transition-opacity duration-200"
    ></div>
    <!-- Radial Ambient Vignette for Depth -->
    <div 
      class="absolute inset-0 z-10 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(0,0,0,0.5)_100%)]"
    ></div>
    <!-- Bottom Blend Gradient to seamlessly meet the next section -->
    <div 
      id="hero-bottom-blend"
      class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#f9f9ff] via-[#f9f9ff]/20 to-transparent z-10 pointer-events-none opacity-0 transition-opacity duration-300"
    ></div>

    <!-- Hero Content (Headline, Subtitle, CTAs) -->
    <div 
      id="hero-content" 
      class="relative z-20 max-w-5xl mx-auto px-5 sm:px-6 lg:px-8 text-center flex flex-col items-center justify-center will-change-transform"
    >
      <!-- Editorial Eyebrow Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5  mb-6 ">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-[11px] md:text-xs tracking-[0.25em] font-bold text-white uppercase font-headline">
          ARCHITECTURAL EXCELLENCE
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] mb-6 uppercase font-headline drop-shadow-md max-w-4xl">
        Building Excellence, <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white/95 to-white/80">
          Delivering Luxury.
        </span>
      </h1>

      <!-- Supporting Body -->
      <p class="text-sm sm:text-base md:text-lg text-white/85 max-w-2xl mx-auto mb-8 font-light leading-relaxed drop-shadow-sm">
        Premium turnkey construction and bespoke real estate development tailored to your ambition. Experience architectural masterpieces executed with uncompromising precision.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto">
        <a 
          href="/projects" 
          class="w-full sm:w-auto h-13 px-8 rounded-full bg-primary text-on-primary text-xs md:text-sm font-bold tracking-widest uppercase flex items-center justify-center gap-2 shadow-[0_8px_30px_rgb(0,90,180,0.45)] hover:bg-primary-container hover:shadow-[0_12px_35px_rgb(0,90,180,0.6)] active:scale-[0.98] transition-all group"
        >
          <span>Explore Our Work</span>
          <svg class="w-4 h-4 text-on-primary group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto h-13 px-8 rounded-full border border-white/30 bg-white/10 text-white text-xs md:text-sm font-bold tracking-widest uppercase flex items-center justify-center backdrop-blur-md hover:bg-white/20 active:scale-[0.98] transition-all"
        >
          Start a Project
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // =========================================================================
  // APPLE-CLASS SCROLL ANIMATION ENGINE
  // Frame-rate independent · Flicker-free · Exponential decay smoothing
  // =========================================================================

  const CONFIG = {
    totalFrames: 149,
    framePath: (index: number) => `/paanya-landing-page-animation/frame_${String(index).padStart(3, '0')}.jpg`,
    initialFrame: 1,
    // Frame-rate independent smoothing speed (higher = snappier, lower = dreamier)
    // Apple typically uses ~8-12 for scroll-linked animations
    smoothingSpeed: 9,
    // Snap to target when within this distance (prevents infinite micro-iterations)
    snapThreshold: 0.06,
    // Max parallel background downloads
    maxConcurrentDownloads: 6,
    // Number of frames to buffer ahead of scroll position
    lookaheadBuffer: 20,
    // Source image aspect ratio (1920 / 1080 = 16:9)
    imageAspectRatio: 1920 / 1080,
  };

  // ─── State ────────────────────────────────────────────────────────────────
  let currentFrame = 1;
  let targetFrame = 1;
  let isAnimating = false;
  let lastRenderedIndex = -1;         // -1 = nothing painted yet
  let scrollDirection = 1;            // 1 = forward, -1 = backward
  let canvasRevealed = false;         // Has canvas been shown to the user?
  let lastTimestamp = 0;              // For frame-rate independent dt

  // ─── DOM Elements ─────────────────────────────────────────────────────────
  const container = document.getElementById('hero-scroll-container');
  const stickyFrame = document.getElementById('hero-sticky-frame');
  const canvas = document.getElementById('hero-frame-canvas') as HTMLCanvasElement | null;
  const fallbackImg = document.getElementById('hero-fallback-img') as HTMLImageElement | null;
  const overlayDark = document.getElementById('hero-overlay-dark');
  const bottomBlend = document.getElementById('hero-bottom-blend');
  const heroContent = document.getElementById('hero-content');
  const heroScrollHint = document.getElementById('hero-scroll-hint');

  if (canvas && container && stickyFrame) {
    const ctx = canvas.getContext('2d', { alpha: false });

    // Image cache & download management
    const imageCache = new Map<number, HTMLImageElement>();
    const loadingSet = new Set<number>();
    const pendingQueue: number[] = [];
    let activeDownloads = 0;

    // Detect reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      container.classList.remove('min-h-[260vh]', 'md:min-h-[320vh]');
      container.classList.add('min-h-[85vh]');
      stickyFrame.classList.remove('sticky', 'top-20');
      stickyFrame.classList.add('relative', 'h-[85vh]');
      if (heroScrollHint) heroScrollHint.style.display = 'none';
    } else {

      // =====================================================================
      // CANVAS SIZING (Retinal-sharp with mobile-optimized DPR)
      // =====================================================================
      function resizeCanvas() {
        if (!canvas || !ctx) return;
        const rect = canvas.getBoundingClientRect();
        // Mobile caps at 1.5x DPR to reduce GPU pressure
        const isMobile = window.innerWidth < 768;
        const dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);

        const newW = Math.round(rect.width * dpr);
        const newH = Math.round(rect.height * dpr);

        if (canvas.width !== newW || canvas.height !== newH) {
          canvas.width = newW;
          canvas.height = newH;
        }

        // Repaint currently displayed frame after resize
        if (lastRenderedIndex > 0) {
          const img = imageCache.get(lastRenderedIndex);
          if (img) renderImageCover(img);
        }
      }

      // =====================================================================
      // CANVAS RENDERING (Aspect-ratio cover)
      // =====================================================================
      function renderImageCover(img: HTMLImageElement) {
        if (!ctx || !canvas) return;

        const imgW = img.naturalWidth || 1920;
        const imgH = img.naturalHeight || 1080;
        const imgRatio = imgW / imgH;
        const cRatio = canvas.width / canvas.height;

        let rW: number, rH: number, rX: number, rY: number;

        if (cRatio > imgRatio) {
          rW = canvas.width;
          rH = canvas.width / imgRatio;
          rX = 0;
          rY = (canvas.height - rH) / 2;
        } else {
          rH = canvas.height;
          rW = canvas.height * imgRatio;
          rX = (canvas.width - rW) / 2;
          rY = 0;
        }

        ctx.drawImage(img, rX, rY, rW, rH);
      }

      // =====================================================================
      // CANVAS REVEAL (Eliminates black-flash / flicker on hard refresh)
      // =====================================================================
      function revealCanvas() {
        if (canvasRevealed || !canvas) return;
        canvasRevealed = true;
        // Fade in the canvas over the fallback image
        canvas.style.opacity = '1';
        // After the CSS transition completes, hide fallback to save memory
        setTimeout(() => {
          if (fallbackImg) {
            fallbackImg.style.visibility = 'hidden';
          }
        }, 500);
      }

      // =====================================================================
      // DIRECTIONAL FRAME LOOKUP (Monotonic — never jumps against scroll)
      // =====================================================================
      function getBestAvailableFrame(requestedIdx: number): { img: HTMLImageElement; index: number } | null {
        // Exact match
        if (imageCache.has(requestedIdx)) {
          return { img: imageCache.get(requestedIdx)!, index: requestedIdx };
        }

        const anchor = lastRenderedIndex > 0 ? lastRenderedIndex : 1;

        if (scrollDirection >= 0) {
          // Forward: walk backward from requested to anchor
          for (let i = requestedIdx; i >= anchor; i--) {
            if (imageCache.has(i)) return { img: imageCache.get(i)!, index: i };
          }
        } else {
          // Backward: walk forward from requested to anchor
          for (let i = requestedIdx; i <= anchor; i++) {
            if (imageCache.has(i)) return { img: imageCache.get(i)!, index: i };
          }
        }

        // Absolute fallback
        if (imageCache.has(anchor)) return { img: imageCache.get(anchor)!, index: anchor };
        if (imageCache.has(1)) return { img: imageCache.get(1)!, index: 1 };
        return null;
      }

      function drawFrame(targetIdx: number) {
        const frameData = getBestAvailableFrame(targetIdx);
        if (!frameData) return;

        // Only repaint when frame actually changes (saves GPU + prevents micro-stutters)
        if (frameData.index !== lastRenderedIndex) {
          renderImageCover(frameData.img);
          lastRenderedIndex = frameData.index;

          // First paint → reveal canvas smoothly over fallback
          if (!canvasRevealed) revealCanvas();
        }
      }

      // =====================================================================
      // PROGRESSIVE PRELOADING ENGINE
      // =====================================================================
      function fetchFrame(index: number): Promise<void> {
        if (imageCache.has(index) || loadingSet.has(index)) return Promise.resolve();

        loadingSet.add(index);
        activeDownloads++;

        return new Promise<void>((resolve) => {
          const img = new Image();
          img.src = CONFIG.framePath(index);

          const onLoaded = () => {
            imageCache.set(index, img);
            loadingSet.delete(index);
            activeDownloads--;

            // If newly loaded frame fills current scroll position, draw immediately
            const currentInt = Math.round(currentFrame);
            if (index === currentInt || (scrollDirection >= 0 && index > lastRenderedIndex && index <= currentInt)) {
              drawFrame(currentInt);
            }

            pumpQueue();
            resolve();
          };

          if ('decode' in HTMLImageElement.prototype) {
            img.decode().then(onLoaded).catch(onLoaded);
          } else {
            img.onload = onLoaded;
            img.onerror = () => {
              loadingSet.delete(index);
              activeDownloads--;
              pumpQueue();
              resolve();
            };
          }
        });
      }

      function pumpQueue() {
        while (activeDownloads < CONFIG.maxConcurrentDownloads && pendingQueue.length > 0) {
          const nextIdx = pendingQueue.shift();
          if (nextIdx !== undefined) fetchFrame(nextIdx);
        }
      }

      function queueFrame(index: number) {
        if (imageCache.has(index) || loadingSet.has(index) || pendingQueue.includes(index)) return;
        pendingQueue.push(index);
        pumpQueue();
      }

      // Slides lookahead window to front of queue based on scroll direction
      function prioritizeWindow(centerIdx: number, forward: boolean) {
        const batch: number[] = [];
        const windowSize = CONFIG.lookaheadBuffer;

        if (forward) {
          for (let i = 1; i <= windowSize; i++) {
            const idx = centerIdx + i;
            if (idx <= CONFIG.totalFrames && !imageCache.has(idx) && !loadingSet.has(idx)) batch.push(idx);
          }
        } else {
          for (let i = 1; i <= windowSize; i++) {
            const idx = centerIdx - i;
            if (idx >= 1 && !imageCache.has(idx) && !loadingSet.has(idx)) batch.push(idx);
          }
        }

        // Prepend to front of queue
        for (let i = batch.length - 1; i >= 0; i--) {
          const idx = batch[i];
          const existing = pendingQueue.indexOf(idx);
          if (existing !== -1) pendingQueue.splice(existing, 1);
          pendingQueue.unshift(idx);
        }
        pumpQueue();
      }

      function initializePreloading() {
        // 1. Poster frame (frame 1)
        fetchFrame(1).then(() => {
          lastRenderedIndex = 1;
          renderImageCover(imageCache.get(1)!);
          revealCanvas();

          // 2. Immediate scroll runway (frames 2-20)
          for (let i = 2; i <= 20 && i <= CONFIG.totalFrames; i++) queueFrame(i);

          // 3. Sparse milestone keyframes for fast-scroll resilience
          for (let i = 28; i <= CONFIG.totalFrames; i += 8) queueFrame(i);

          // 4. Background fill for remaining frames
          for (let i = 21; i <= CONFIG.totalFrames; i++) {
            if (!pendingQueue.includes(i) && !imageCache.has(i)) queueFrame(i);
          }
        });
      }

      // =====================================================================
      // SCROLL POSITION CALCULATION
      // =====================================================================
      function calculateScrollProgress(): number {
        if (!container) return 0;
        const rect = container.getBoundingClientRect();
        const headerOffset = 80;
        const viewportHeight = window.innerHeight - headerOffset;
        const totalScrollableDistance = rect.height - viewportHeight;
        if (totalScrollableDistance <= 0) return 0;
        const scrolled = headerOffset - rect.top;
        return Math.min(Math.max(scrolled / totalScrollableDistance, 0), 1);
      }

      // =====================================================================
      // OVERLAY / PARALLAX EFFECTS
      // =====================================================================
      function updateOverlayElements(progress: number) {
        if (heroContent) {
          const fadeProgress = Math.min(progress / 0.22, 1);
          const opacity = Math.max(0, 1 - fadeProgress);
          const translateY = -fadeProgress * 45;
          const scale = 1 - fadeProgress * 0.04;
          heroContent.style.opacity = String(opacity);
          heroContent.style.transform = `translate3d(0, ${translateY}px, 0) scale(${scale})`;
          heroContent.style.pointerEvents = opacity < 0.1 ? 'none' : 'auto';
        }

        if (heroScrollHint) {
          heroScrollHint.style.opacity = String(Math.max(0, 1 - progress * 7));
        }

        if (overlayDark) {
          const darkProgress = Math.min(progress / 0.45, 1);
          overlayDark.style.opacity = String(0.85 - darkProgress * 0.6);
        }

        if (bottomBlend) {
          const blendProgress = Math.max(0, (progress - 0.85) / 0.15);
          bottomBlend.style.opacity = String(blendProgress);
        }
      }

      // =====================================================================
      // ANIMATION LOOP (Frame-rate independent exponential decay)
      // =====================================================================
      // Uses `1 - exp(-speed * dt)` for consistent buttery motion at
      // 60Hz, 120Hz, and 144Hz displays without any tuning.
      // =====================================================================
      function animationTick(timestamp: number) {
        // Calculate delta time (capped at 50ms to prevent huge jumps after tab-switch)
        if (!lastTimestamp) lastTimestamp = timestamp;
        const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.05);
        lastTimestamp = timestamp;

        const delta = targetFrame - currentFrame;

        if (Math.abs(delta) > CONFIG.snapThreshold) {
          // Exponential decay: frame-rate independent smoothing
          const factor = 1 - Math.exp(-CONFIG.smoothingSpeed * dt);
          currentFrame += delta * factor;
          drawFrame(Math.round(currentFrame));
          requestAnimationFrame(animationTick);
        } else {
          // Snap to target and stop the loop
          currentFrame = targetFrame;
          drawFrame(Math.round(currentFrame));
          isAnimating = false;
          lastTimestamp = 0;
        }
      }

      // =====================================================================
      // SCROLL HANDLER
      // =====================================================================
      function onScroll() {
        const progress = calculateScrollProgress();
        const newTarget = 1 + progress * (CONFIG.totalFrames - 1);

        // Detect direction
        if (newTarget > targetFrame) scrollDirection = 1;
        else if (newTarget < targetFrame) scrollDirection = -1;
        targetFrame = newTarget;

        // Update parallax overlays
        updateOverlayElements(progress);

        // Prioritize frames ahead of the user's scroll direction
        prioritizeWindow(Math.round(currentFrame), scrollDirection >= 0);

        // Start the smooth animation loop if not already running
        if (!isAnimating) {
          isAnimating = true;
          lastTimestamp = 0; // Reset for fresh dt calculation
          requestAnimationFrame(animationTick);
        }
      }

      // =====================================================================
      // VISIBILITY API (Pause when tab hidden, resync on return)
      // =====================================================================
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
          // Coming back to tab — reset timestamp and resync
          lastTimestamp = 0;
          if (!isAnimating) onScroll();
        }
      });

      // =====================================================================
      // INITIALIZE
      // =====================================================================
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', resizeCanvas, { passive: true });

      resizeCanvas();
      initializePreloading();
      onScroll();
    }
  }
</script>
