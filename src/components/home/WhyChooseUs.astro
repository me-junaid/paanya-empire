---
const reasons = [
  {
    title: "Uncompromising Quality",
    description: "We use only premium materials and partner with master craftsmen to ensure every detail of your project meets the highest standards of luxury."
  },
  {
    title: "Absolute Transparency",
    description: "Our turnkey approach means clear pricing, detailed timelines, and regular updates. No hidden costs, no unexpected delays."
  },
  {
    title: "Engineering Excellence",
    description: "Structural integrity is the foundation of luxury. Our in-house engineering team ensures your property is built to last generations."
  }
];
---
<section class="py-24 bg-primary text-on-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <div class="lg:col-span-1">
        <p class="text-on-primary/80 font-bold tracking-widest uppercase mb-4 text-sm">The Paanya Standard</p>
        <h2 class="text-headline-lg text-on-primary mb-6">Why Choose Us</h2>
        <p class="text-on-primary/90 text-body-md mb-8">
          Choosing Paanya Empire means choosing peace of mind. We handle every complexity of construction so you can focus on the excitement of your new space.
        </p>
        <a href="/process" class="inline-flex items-center font-bold hover:text-outline-variant transition-colors">
          Explore Our Process
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-8">
        {reasons.map((reason, index) => (
          <div class="bg-primary-container/40 p-8 rounded-2xl border border-on-primary/10">
            <div class="text-3xl font-bold text-on-primary/30 mb-4">0{index + 1}</div>
            <h3 class="text-xl font-bold text-on-primary mb-3">{reason.title}</h3>
            <p class="text-on-primary/80 text-body-md">{reason.description}</p>
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>
