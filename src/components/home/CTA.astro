---
---
<section class="py-24 relative overflow-hidden bg-on-surface">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=1200" 
      alt="Construction site" 
      class="w-full h-full object-cover opacity-20"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-headline-lg text-on-primary mb-6">Ready to Build Your Legacy?</h2>
    <p class="text-body-md md:text-xl text-on-primary/80 mb-10 max-w-2xl mx-auto">
      Contact our team today to schedule an initial consultation. Let's discuss how we can turn your architectural vision into reality.
    </p>
    <a 
      href="/contact" 
      class="inline-block bg-primary text-on-primary px-10 py-4 rounded-lg text-label-md font-bold hover:bg-primary-container transition-colors shadow-lg"
    >
      Start Your Project
    </a>
  </div>
</section>
