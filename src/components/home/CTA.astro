---
---

<section class="py-16 sm:py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/10 bg-[#071326] text-on-primary py-16 sm:py-24 px-6 sm:px-12 lg:px-16 text-center">
      
      <!-- Architectural Ambient Background -->
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80&w=1600" 
          alt="Paanya Empire architectural luxury villa" 
          class="w-full h-full object-cover opacity-25 scale-105 transition-transform duration-1000"
          loading="lazy"
          decoding="async"
        />
        <!-- Deep Cinematic Gradients for Rich Legibility -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#071326]/90 via-[#071326]/85 to-[#071326]/95"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(7,19,38,0.9)_100%)]"></div>
        <!-- Ambient Decorative Glow -->
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
      </div>

      <!-- Content Container -->
      <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
        

        <!-- Headline -->
        <h2 class="font-headline text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
          Ready to Build Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-sky-200 to-white">Architectural Legacy?</span>
        </h2>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-white/80 mb-10 max-w-2xl mx-auto font-normal leading-relaxed">
          Contact our multidisciplinary team today to schedule an initial consultation. Let's discuss how we can turn your architectural vision into reality.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto mb-12">
          <a 
            href="/contact" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-primary text-on-primary px-8 py-4 rounded-xl text-label-md font-bold hover:bg-primary-container transition-all duration-300 shadow-lg hover:shadow-primary/30 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Start Your Project</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>

          <a 
            href="/projects" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl text-label-md font-semibold border border-white/20 backdrop-blur-sm transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Portfolio</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-8 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-6 w-full text-center">
          <div class="flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-white/75">
            <span class="material-symbols-outlined text-primary-container text-[18px]">verified</span>
            <span>10-Year Structural Guarantee</span>
          </div>
          <div class="flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-white/75">
            <span class="material-symbols-outlined text-primary-container text-[18px]">hub</span>
            <span>BIM Turnkey Integration</span>
          </div>
          <div class="flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-white/75">
            <span class="material-symbols-outlined text-primary-container text-[18px]">schedule</span>
            <span>On-Time Milestone Handover</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
