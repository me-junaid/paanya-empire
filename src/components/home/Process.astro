<div class="flex flex-col w-full">
  <!-- 8. PROCESS — HORIZONTAL DESKTOP TIMELINE -->
  <section class="w-full py-14 sm:py-24 lg:py-28 bg-surface-container-low overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-16 gap-4 sm:gap-6">
        <div>
          <span class="font-label text-[11px] sm:text-[12px] uppercase font-semibold tracking-[0.2em] sm:tracking-[0.22em] text-primary block mb-2">
            Our Execution Blueprint
          </span>
          <h2 class="font-headline text-2xl sm:text-3xl lg:text-5xl font-bold text-on-surface tracking-tight">
            From First Conversation<br/>To Key Handover.
          </h2>
        </div>
        <a class="inline-flex items-center gap-2 font-label text-xs uppercase tracking-widest font-semibold text-primary hover:text-primary-container transition-colors" href="/process">
          Explore Complete 12-Stage Process
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
      
      <!-- 8-Step Continuous Desktop Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">01 / DISCOVERY</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Consultation</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Lifestyle mapping, brief definition, and strategic aesthetic vision alignment.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">02 / FEASIBILITY</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Site Feasibility</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Geotechnical soil testing, site contours, and local municipal zoning survey.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">03 / ARCHITECTURE</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">BIM Design</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Volumetric 3D spatial walkthroughs, structural modeling, and engineering.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">04 / COMMERCIAL</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">BOQ Estimation</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Itemized transparent cost schedule and locked material specifications.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">05 / APPROVALS</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Statutory Permits</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Seamless handling of municipal clearances, NOCs, and sanctions.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">06 / EXECUTION</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Structural Build</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Civil engineering, casting, masonry, and coordinated MEP installation.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">07 / FINISHING</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Bespoke Finishing</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">Custom millwork, imported stone, acoustic glazing, and automation.</p>
        </div>
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-xl shadow-sm relative bg-primary-fixed/30">
          <span class="font-label text-[11px] sm:text-xs font-bold text-primary block mb-1.5 sm:mb-2">08 / MILESTONE</span>
          <h4 class="font-headline text-sm sm:text-base font-bold text-on-surface mb-1 sm:mb-2">Key Handover</h4>
          <p class="text-xs text-on-surface-variant leading-relaxed">100-point joint inspection, occupancy dossier, and 10-year warranty pack.</p>
        </div>
      </div>
    </div>
  </section>

