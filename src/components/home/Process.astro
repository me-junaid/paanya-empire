---
const steps = [
  {
    title: "Initial Consultation",
    description: "We discuss your vision, budget, and requirements to understand the full scope of your project."
  },
  {
    title: "Design & Planning",
    description: "Our architects and designers create detailed blueprints, 3D renderings, and material schedules."
  },
  {
    title: "Approvals & Permits",
    description: "We handle all bureaucratic requirements, ensuring your project is fully compliant with local regulations."
  },
  {
    title: "Construction",
    description: "Our engineers and craftsmen build your property with precision, overseen by a dedicated project manager."
  },
  {
    title: "Handover",
    description: "After rigorous quality checks, we hand over the keys to your pristine, ready-to-move-in property."
  }
];
---
<section class="py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-label-md font-bold text-primary tracking-widest uppercase mb-4">How We Work</p>
      <h2 class="text-headline-lg text-on-surface mb-6">The Turnkey Experience</h2>
      <p class="text-body-md text-on-surface-variant">
        A seamless, five-step journey from your initial idea to stepping into your completed luxury property.
      </p>
    </div>

    <div class="relative">
      <!-- Connecting line for desktop -->
      <div class="hidden md:block absolute top-6 left-[10%] right-[10%] h-0.5 bg-outline-variant/60 -translate-y-1/2 z-0"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 relative z-10">
        {steps.map((step, index) => (
          <div class="relative bg-surface p-6 rounded-2xl border border-outline-variant/30 md:border-none md:bg-transparent md:p-0">
            <div class="hidden md:flex w-12 h-12 rounded-full bg-primary text-on-primary font-bold items-center justify-center mx-auto mb-6 shadow-md border-4 border-surface relative z-10">
              {index + 1}
            </div>
            <div class="md:hidden text-primary font-bold text-xl mb-2">Step {index + 1}</div>
            <h3 class="text-lg font-bold text-on-surface mb-3 md:text-center">{step.title}</h3>
            <p class="text-sm text-on-surface-variant md:text-center">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
