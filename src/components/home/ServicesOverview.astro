---
const services = [
  {
    title: "Turnkey Construction",
    description: "End-to-end construction services, managing every aspect from foundation to final finishing with absolute precision.",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
  },
  {
    title: "Architectural Design",
    description: "Visionary architectural planning that balances aesthetic luxury with structural integrity and functional living spaces.",
    icon: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
  },
  {
    title: "Interior Design",
    description: "Bespoke interior styling tailored to your lifestyle, using premium materials to create environments of refined elegance.",
    icon: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
  }
];
---
<section class="py-24 bg-surface/50 border-t border-outline-variant/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-label-md font-bold text-primary tracking-widest uppercase mb-4">Our Expertise</p>
      <h2 class="text-headline-lg text-on-surface mb-6">Comprehensive Construction Solutions</h2>
      <p class="text-body-md text-on-surface-variant">
        We offer a complete suite of services designed to make your journey from concept to reality seamless, transparent, and spectacular.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {services.map(service => (
        <div class="bg-surface p-8 rounded-2xl border border-outline-variant/30 hover:border-primary/50 transition-colors shadow-sm hover:shadow-md">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 text-primary">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-on-surface mb-3">{service.title}</h3>
          <p class="text-body-md text-on-surface-variant mb-6">{service.description}</p>
          <a href="/services" class="text-primary font-medium hover:text-primary-container flex items-center">
            Learn more
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a href="/services" class="inline-block bg-white border border-outline text-on-surface px-8 py-3 rounded-lg text-label-md font-bold hover:border-primary hover:text-primary transition-colors shadow-sm">
        View All Services
      </a>
    </div>
  </div>
</section>
