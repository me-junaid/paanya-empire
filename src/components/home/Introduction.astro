<!-- 3. WHO WE ARE (Editorial 12-Column Asymmetry) -->
<section class="w-full py-14 sm:py-24 lg:py-28 bg-surface">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- 7 Columns Visual -->
      <div class="lg:col-span-7 relative group">
        <div class="relative overflow-hidden rounded-xl shadow-xl bg-surface-container-high aspect-[16/11]">
          <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Professional civil engineers and lead architects examining detailed architectural blueprint drawings on an active high-rise commercial construction site with structural steel framework, tower cranes, and clear blue sky in modern crisp daylight." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuaw635AKen5D_MIZqGYwgO2jo4nDe-m7inBwZG5B8KpaO0UmS4yUL8vYxFO0rl6-YuPBwxb8YVguA1_3RApYn5_8YWlYGrZTjhCftZc48zZdPR2z4fPeLxR7Evg9BFOSyYMjS2CIZO7A7jKglrsE_H6Yi55FRYUmnic9tWwsflTc84lhuvUMkdTXNpnHIaJRcu1PQVNVPzurw4xBvMSJYbe_JXss_d4TlgPyb5Xvo9_9r33w8wmLMZQ"/>
          <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 flex items-center justify-between text-on-primary">
            <span class="font-label text-[10px] sm:text-xs tracking-[0.16em] sm:tracking-[0.2em] uppercase font-semibold bg-inverse-surface/70 backdrop-blur-md px-3 sm:px-4 py-1.5 sm:py-2 rounded">
              Precision Structural Rigor Applied To Every Foundation
            </span>
            <span class="material-symbols-outlined text-secondary-fixed text-[20px]">engineering</span>
          </div>
        </div>
        
        <!-- Overlapping Decorative Blueprint Marker -->
        <div class="hidden sm:flex absolute -top-6 -right-6 bg-surface-container-lowest p-6 rounded-xl shadow-xl max-w-xs flex-col">
          <span class="font-label text-[11px] font-bold uppercase tracking-widest text-primary mb-1">ISO 9001:2015</span>
          <p class="text-xs text-on-surface-variant leading-relaxed">Certified QA/QC concrete testing &amp; structural engineering protocols.</p>
        </div>
      </div>
      
      <!-- 5 Columns Narrative -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <span class="font-label text-[11px] sm:text-[12px] uppercase font-semibold tracking-[0.2em] sm:tracking-[0.22em] text-primary mb-2 sm:mb-3">
          Who We Are
        </span>
        <h2 class="font-headline text-2xl sm:text-3xl lg:text-[44px] font-bold text-on-surface leading-[1.15] mb-4 sm:mb-6">
          We Build More Than Homes.<br/>
          We Build Complete Experiences.
        </h2>
        <p class="font-body text-sm sm:text-base text-on-surface-variant leading-relaxed mb-6 sm:mb-8">
          Paanya Empire bridges design, engineering, construction, and bespoke interiors together through one unified, cohesive process. Eliminating multi-contractor finger-pointing, our multidisciplinary team takes absolute single-point accountability.
        </p>
        
        <div class="grid grid-cols-3 gap-3 sm:gap-6 pt-4 sm:pt-6 border-t border-outline-variant/30 mb-6 sm:mb-8">
          <div>
            <span class="font-headline text-2xl sm:text-3xl font-bold text-primary block">45+</span>
            <span class="text-[10px] sm:text-xs text-on-surface-variant mt-1 block uppercase tracking-wider">Projects Handed Over</span>
          </div>
          <div>
            <span class="font-headline text-2xl sm:text-3xl font-bold text-primary block">18+</span>
            <span class="text-[10px] sm:text-xs text-on-surface-variant mt-1 block uppercase tracking-wider">Years In-House Leadership</span>
          </div>
          <div>
            <span class="font-headline text-2xl sm:text-3xl font-bold text-primary block">60+</span>
            <span class="text-[10px] sm:text-xs text-on-surface-variant mt-1 block uppercase tracking-wider">Certified Specialists</span>
          </div>
        </div>
        
        <div>
          <a class="inline-flex items-center gap-2 font-label text-xs sm:text-sm font-semibold tracking-wider text-primary hover:text-primary-container transition-colors uppercase" href="/about">
            Discover Paanya Empire
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>
