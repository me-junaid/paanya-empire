---
import { getConstructionPackages, getDefaultInputs, calculateEstimate, formatCurrency } from '../../lib/calculator';
import { FLOOR_CONFIGS } from '../../data/calculator';
import type { FloorConfig } from '../../types/calculator';

const packages = getConstructionPackages();
const defaults = getDefaultInputs();
const initialEstimate = calculateEstimate(defaults);

const floorKeys = Object.keys(FLOOR_CONFIGS) as FloorConfig[];
---

<!-- =========================================================
     PAANYA EMPIRE — CONSTRUCTION COST CALCULATOR
     Interactive component — vanilla JS, zero framework deps
     ========================================================= -->

<section id="cost-calculator" class="py-20 bg-surface-container-low/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="text-[11px] font-bold tracking-[0.2em] uppercase text-primary mb-3">
        Free Construction Estimator
      </p>
      <h2 class="text-headline-lg text-on-surface mb-4">
        Cost Calculator
      </h2>
      <p class="text-body-md text-on-surface-variant">
        Get an accurate indicative budget for your construction project — instantly.
        Configure your plot area, floor count, package, and add-ons to see a detailed cost breakdown.
      </p>
    </div>

    <!-- Two-column layout: Inputs | Results -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-8 items-start">

      <!-- ─────────────────────────────────────────────
           LEFT PANEL: Inputs
           ───────────────────────────────────────────── -->
      <div class="flex flex-col gap-6">

        <!-- Card: Area & Floors -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-6 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">square_foot</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-on-surface uppercase tracking-wider">Plot / Floor Area & Configuration</h3>
              <p class="text-[11px] text-on-surface-variant">Set your per-floor footprint and number of floors</p>
            </div>
          </div>

          <div class="flex flex-col gap-5">
            <!-- Per-Floor Footprint Slider -->
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <div>
                  <label for="calc-area" class="text-[11px] font-semibold uppercase tracking-wider text-on-surface">
                    Per-Floor Footprint / Plot Construction Area
                  </label>
                  <p class="text-[10px] text-on-surface-variant">Ground slab size per floor</p>
                </div>
                <div class="flex items-baseline gap-1 bg-surface-container px-3 py-1.5 rounded-xl border border-outline-variant/30">
                  <span id="area-display" class="text-base font-bold text-primary">{defaults.perFloorArea.toLocaleString('en-IN')}</span>
                  <span class="text-[11px] text-on-surface-variant font-medium">sq.ft / floor</span>
                </div>
              </div>
              <input
                id="calc-area"
                type="range"
                min="500"
                max="6000"
                step="50"
                value={defaults.perFloorArea}
                class="calc-range w-full h-2 rounded-full appearance-none cursor-pointer"
                aria-label="Per-floor area in square feet"
              />
              <div class="flex justify-between text-[10px] text-outline font-medium">
                <span>500 sq.ft</span>
                <span>6,000 sq.ft</span>
              </div>
            </div>

            <!-- Floor Configuration Buttons -->
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <label class="text-[11px] font-semibold uppercase tracking-wider text-on-surface">
                  Number of Floors / Structure
                </label>
                <span id="floor-desc-badge" class="text-[11px] font-semibold text-primary">
                  {FLOOR_CONFIGS[defaults.floorConfig].description}
                </span>
              </div>
              <div class="grid grid-cols-4 sm:grid-cols-7 gap-2">
                {floorKeys.map((f) => (
                  <button
                    type="button"
                    data-floor={f}
                    class={`floor-btn py-2.5 px-1 text-[11px] sm:text-xs font-bold rounded-xl border transition-all text-center ${
                      f === defaults.floorConfig
                        ? 'bg-primary text-on-primary border-primary shadow-md ring-2 ring-primary/20'
                        : 'bg-surface-container text-on-surface-variant border-outline-variant/30 hover:border-primary/50 hover:text-primary'
                    }`}
                  >
                    {f}
                  </button>
                ))}
              </div>
            </div>

            <!-- Computed Total Built-Up Area Banner -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-primary/5 border border-primary/20">
              <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-[20px] text-primary">apartment</span>
                <div>
                  <div class="text-[11px] font-bold text-on-surface uppercase tracking-wider">Total Built-Up Area (BUA)</div>
                  <div class="text-[10px] text-on-surface-variant" id="total-bua-formula">
                    {defaults.perFloorArea.toLocaleString('en-IN')} sq.ft × {FLOOR_CONFIGS[defaults.floorConfig].multiplier} floor multiplier
                  </div>
                </div>
              </div>
              <div class="text-right">
                <span id="total-bua-display" class="text-lg font-bold text-primary">
                  {initialEstimate.totalBuiltUpArea.toLocaleString('en-IN')}
                </span>
                <span class="text-xs font-semibold text-on-surface-variant"> sq.ft</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Card: Package Selection -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-6 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-on-surface uppercase tracking-wider">Construction Package</h3>
              <p class="text-[11px] text-on-surface-variant">Select your quality tier and material specification</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {packages.map((pkg) => (
              <button
                type="button"
                data-package={pkg.id}
                class={`pkg-btn relative flex flex-col gap-2 p-4 rounded-xl border-2 text-left transition-all ${
                  pkg.id === defaults.packageTier
                    ? `border-primary bg-primary/5 shadow-md ring-2 ring-primary/20`
                    : 'border-outline-variant/30 bg-surface-container hover:border-primary/40'
                }`}
              >
                {pkg.badge && (
                  <span class="absolute top-3 right-3 text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary text-on-primary">
                    {pkg.badge}
                  </span>
                )}
                <div class="text-xs font-bold text-on-surface">{pkg.name}</div>
                <div class="text-[10px] text-on-surface-variant leading-snug">{pkg.tagline}</div>
                <div class="mt-1 pt-2 border-t border-outline-variant/20">
                  <span class="text-[11px] font-bold text-primary">
                    ₹{pkg.baseRateMin.toLocaleString('en-IN')} – ₹{pkg.baseRateMax.toLocaleString('en-IN')}
                  </span>
                  <span class="text-[10px] text-on-surface-variant"> /sq.ft</span>
                </div>
              </button>
            ))}
          </div>

          <!-- Expandable material specs -->
          <div id="pkg-specs-panel" class="mt-4">
            <button
              type="button"
              id="toggle-specs-btn"
              class="flex items-center gap-1.5 text-[11px] font-bold text-primary uppercase tracking-wider hover:text-primary-container transition-colors"
            >
              <span class="material-symbols-outlined text-[16px]" id="specs-icon">expand_more</span>
              <span id="specs-btn-label">View material specifications</span>
            </button>

            <div id="specs-table" class="hidden mt-4 rounded-xl bg-surface-container p-4 border border-outline-variant/20">
              <p class="text-[10px] font-bold uppercase tracking-wider text-outline mb-3" id="specs-package-name">
                {packages.find(p => p.id === defaults.packageTier)?.name} — Included Specifications
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="specs-grid">
                {packages.find(p => p.id === defaults.packageTier)?.materialSpecs.map(spec => (
                  <div class="flex flex-col gap-0.5 p-2 rounded-lg bg-surface-container-low">
                    <span class="text-[9px] font-bold uppercase tracking-wider text-outline">{spec.category}</span>
                    <span class="text-[11px] font-medium text-on-surface">{spec.spec}</span>
                    {spec.brand && (
                      <span class="text-[10px] text-primary font-semibold">{spec.brand}</span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Card: Structural Add-ons -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-6 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">add_circle</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-on-surface uppercase tracking-wider">Structural Add-Ons</h3>
              <p class="text-[11px] text-on-surface-variant">Include optional site and structural elements</p>
            </div>
          </div>

          <div class="flex flex-col gap-4">

            <!-- Basement -->
            <div class="addon-row flex flex-col gap-3 p-4 rounded-xl border border-outline-variant/20 bg-surface-container/40">
              <label class="flex items-center justify-between cursor-pointer">
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-[22px] text-on-surface-variant">layers</span>
                  <div>
                    <div class="text-xs font-bold text-on-surface">Basement Floor</div>
                    <div class="text-[10px] text-on-surface-variant">Excavation + RCC waterproofing • ₹950/sq.ft</div>
                  </div>
                </div>
                <input type="checkbox" id="addon-basement" data-addon="basement" class="addon-toggle w-5 h-5 accent-primary rounded cursor-pointer" />
              </label>
              <div id="basement-qty" class="hidden flex items-center gap-3 pl-9">
                <label for="basement-area" class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant whitespace-nowrap">
                  Basement Area
                </label>
                <input
                  id="basement-area"
                  type="number"
                  min="200"
                  max="5000"
                  step="50"
                  value="400"
                  class="flex-1 h-9 px-3 rounded-lg bg-surface-container text-xs text-on-surface border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                />
                <span class="text-[11px] text-on-surface-variant font-medium">sq.ft</span>
              </div>
            </div>

            <!-- Compound Wall -->
            <div class="addon-row flex flex-col gap-3 p-4 rounded-xl border border-outline-variant/20 bg-surface-container/40">
              <label class="flex items-center justify-between cursor-pointer">
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-[22px] text-on-surface-variant">fence</span>
                  <div>
                    <div class="text-xs font-bold text-on-surface">Compound Wall</div>
                    <div class="text-[10px] text-on-surface-variant">230mm brick + plastering + coping • ₹850/running ft</div>
                  </div>
                </div>
                <input type="checkbox" id="addon-compoundwall" data-addon="compoundwall" class="addon-toggle w-5 h-5 accent-primary rounded cursor-pointer" />
              </label>
              <div id="compoundwall-qty" class="hidden flex items-center gap-3 pl-9">
                <label for="compoundwall-length" class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant whitespace-nowrap">
                  Perimeter Length
                </label>
                <input
                  id="compoundwall-length"
                  type="number"
                  min="20"
                  max="1000"
                  step="10"
                  value="100"
                  class="flex-1 h-9 px-3 rounded-lg bg-surface-container text-xs text-on-surface border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                />
                <span class="text-[11px] text-on-surface-variant font-medium">running ft</span>
              </div>
            </div>

            <!-- Sump Tank -->
            <div class="addon-row flex items-center justify-between p-4 rounded-xl border border-outline-variant/20 bg-surface-container/40">
              <label class="flex items-center gap-3 cursor-pointer flex-1">
                <span class="material-symbols-outlined text-[22px] text-on-surface-variant">water</span>
                <div>
                  <div class="text-xs font-bold text-on-surface">Underground Sump Tank</div>
                  <div class="text-[10px] text-on-surface-variant">10,000 L RCC underground sump + pump chamber • ₹75,000 fixed</div>
                </div>
              </label>
              <input type="checkbox" id="addon-sump" data-addon="sump" class="addon-toggle w-5 h-5 accent-primary rounded cursor-pointer" />
            </div>

            <!-- Premium Facade -->
            <div class="addon-row flex items-center justify-between p-4 rounded-xl border border-outline-variant/20 bg-surface-container/40">
              <label class="flex items-center gap-3 cursor-pointer flex-1">
                <span class="material-symbols-outlined text-[22px] text-on-surface-variant">home</span>
                <div>
                  <div class="text-xs font-bold text-on-surface">Premium Architectural Facade</div>
                  <div class="text-[10px] text-on-surface-variant">Stone cladding / GRC panels / double-height glazing • ₹180/sq.ft elevation</div>
                </div>
              </label>
              <input type="checkbox" id="addon-facade" data-addon="facade" class="addon-toggle w-5 h-5 accent-primary rounded cursor-pointer" />
            </div>

          </div>
        </div>

      </div>

      <!-- ─────────────────────────────────────────────
           RIGHT PANEL: Results (sticky on desktop)
           ───────────────────────────────────────────── -->
      <div class="lg:sticky lg:top-28 flex flex-col gap-4">

        <!-- Total Estimate Card -->
        <div class="bg-primary rounded-2xl p-6 shadow-xl text-on-primary relative overflow-hidden">
          <!-- Decorative bg circles -->
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/5 pointer-events-none" aria-hidden="true"></div>
          <div class="absolute -bottom-12 -left-8 w-40 h-40 rounded-full bg-white/5 pointer-events-none" aria-hidden="true"></div>

          <div class="relative z-10">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-on-primary/70 mb-1">Estimated Total Project Cost</p>
            <div id="result-total" class="text-3xl sm:text-4xl font-bold leading-tight">
              {formatCurrency(initialEstimate.totalMin)} – {formatCurrency(initialEstimate.totalMax)}
            </div>
            
            <div class="flex items-center gap-2 mt-2">
              <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-white/20" id="result-package-label">
                {initialEstimate.packageName} Package
              </span>
              <span class="text-[11px] text-on-primary/80" id="result-bua-summary">
                {initialEstimate.totalBuiltUpArea.toLocaleString('en-IN')} sq.ft total ({initialEstimate.floorDescription})
              </span>
            </div>

            <div class="mt-5 pt-4 border-t border-white/20 grid grid-cols-2 gap-4">
              <div>
                <p class="text-[10px] text-on-primary/60 mb-0.5">Base Structure & Build</p>
                <p id="result-base" class="text-sm font-bold">
                  {formatCurrency(initialEstimate.baseCostMin)} – {formatCurrency(initialEstimate.baseCostMax)}
                </p>
              </div>
              <div>
                <p class="text-[10px] text-on-primary/60 mb-0.5">Structural Add-ons</p>
                <p id="result-addons" class="text-sm font-bold">
                  {initialEstimate.addonsCost === 0 ? '—' : formatCurrency(initialEstimate.addonsCost)}
                </p>
              </div>
            </div>

            <p class="text-[9px] text-on-primary/50 mt-4 leading-relaxed">
              * Indicative turnkey estimate for total civil, structural & finishing work across all floors. Excludes land cost, architectural consultation, sanctions, and loose furniture.
            </p>
          </div>
        </div>

        <!-- Cost Breakdown Card -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-5 shadow-sm">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary">pie_chart</span>
            Cost Breakdown by Trade
          </h3>
          <div id="breakdown-list" class="flex flex-col gap-3">
            {initialEstimate.breakdown.map((cat) => (
              <div class="breakdown-item flex flex-col gap-1.5" data-category={cat.label}>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px] text-primary">{cat.icon}</span>
                    <span class="text-[11px] font-medium text-on-surface">{cat.label}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold text-on-surface breakdown-amount">{formatCurrency(cat.amount)}</span>
                    <span class="text-[10px] text-on-surface-variant w-8 text-right breakdown-pct">{cat.percentage}%</span>
                  </div>
                </div>
                <div class="h-1.5 rounded-full bg-surface-container overflow-hidden">
                  <div
                    class="h-full rounded-full bg-primary transition-all duration-500"
                    style={`width: ${cat.percentage}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Material Quantities Card -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-5 shadow-sm">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary">calculate</span>
            Total Material Quantities Estimate
          </h3>
          <div id="material-grid" class="grid grid-cols-2 gap-3">
            {initialEstimate.materials.map((mat) => (
              <div class="material-item flex flex-col gap-1 p-3 rounded-xl bg-surface-container" data-material={mat.label}>
                <span class="material-symbols-outlined text-[18px] text-primary">{mat.icon}</span>
                <span class="text-base font-bold text-on-surface material-value">{mat.value}</span>
                <div>
                  <div class="text-[10px] font-semibold text-on-surface material-label">{mat.label}</div>
                  <div class="text-[10px] text-on-surface-variant material-unit">{mat.unit}</div>
                </div>
              </div>
            ))}
          </div>
          <p class="text-[10px] text-on-surface-variant mt-3 leading-relaxed">
            Scaled across all floors. Final quantities determined by structural engineer's BOQ.
          </p>
        </div>

        <!-- CTA Card -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-on-surface mb-1">Ready to build?</h3>
          <p class="text-[11px] text-on-surface-variant mb-4 leading-relaxed">
            Get a fixed-price Bill of Quantities (BOQ) and schedule a free site inspection with Paanya Empire's engineering team.
          </p>
          <a
            id="calc-cta-btn"
            href="/contact"
            class="flex items-center justify-center gap-2 w-full h-11 rounded-xl bg-primary text-on-primary text-xs font-bold uppercase tracking-wider hover:bg-primary-container transition-colors shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            Book Free Site Consultation
          </a>
          <p class="text-[10px] text-on-surface-variant text-center mt-3">No obligation • Response within 24 hours</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* Range input custom track & thumb */
  .calc-range {
    background: linear-gradient(
      to right,
      var(--color-primary) 0%,
      var(--color-primary) var(--range-pct, 18%),
      var(--color-outline-variant) var(--range-pct, 18%),
      var(--color-outline-variant) 100%
    );
  }
  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 3px solid white;
    box-shadow: 0 1px 6px rgba(0,90,180,0.3);
    cursor: pointer;
    transition: transform 0.15s;
  }
  .calc-range::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .calc-range::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 3px solid white;
    box-shadow: 0 1px 6px rgba(0,90,180,0.3);
    cursor: pointer;
  }
</style>

<script>
// -----------------------------------------------------------------------
// Paanya Empire — Construction Cost Calculator Client Script
// Pure vanilla JS — zero dependencies.
// -----------------------------------------------------------------------

const PACKAGES = {
  classic: { name: 'Classic Premium', rateMin: 1850, rateMax: 2150, badge: null },
  luxury:  { name: 'Luxury',          rateMin: 2250, rateMax: 2750, badge: 'Most Popular' },
  ultra:   { name: 'Ultra Luxury',    rateMin: 2850, rateMax: 3600, badge: 'Bespoke' },
};

const FLOOR_CONFIGS: Record<string, { multiplier: number; desc: string; label: string }> = {
  'G':       { multiplier: 1.0,  desc: '1 Floor (Ground only)',               label: 'Ground (G)' },
  'G+1':     { multiplier: 2.0,  desc: '2 Floors (Ground + 1st Floor)',       label: 'G + 1' },
  'G+2':     { multiplier: 3.0,  desc: '3 Floors (Ground + 1st + 2nd)',       label: 'G + 2' },
  'G+3':     { multiplier: 4.0,  desc: '4 Floors (Ground + 1st + 2nd + 3rd)', label: 'G + 3' },
  'Stilt+1': { multiplier: 1.6,  desc: 'Stilt Parking + 1 Residential Floor', label: 'Stilt + 1' },
  'Stilt+2': { multiplier: 2.6,  desc: 'Stilt Parking + 2 Residential Floors', label: 'Stilt + 2' },
  'Stilt+3': { multiplier: 3.65, desc: 'Stilt Parking + 3 Residential Floors', label: 'Stilt + 3' },
};

const BREAKDOWN = [
  { label: 'Civil Structure & Masonry', pct: 50, icon: 'foundation' },
  { label: 'Finishes & Flooring', pct: 21, icon: 'format_paint' },
  { label: 'MEP — Plumbing & Electrical', pct: 15, icon: 'electrical_services' },
  { label: 'Doors, Windows & Painting', pct: 14, icon: 'door_front' },
];

const MATERIAL_FACTORS = {
  steel: 4.0,     // kg/sqft of total BUA
  cement: 0.40,   // bags/sqft of total BUA
  sand: 1.8,      // cft/sqft of total BUA
  bricks: 8,      // units/sqft of total BUA
};

const ADDON_RATES = {
  basement: 950,
  compoundwall: 850,
  sump: 75000,
  facade: 180,
};

const PACKAGE_SPECS: Record<string, Array<{category: string; spec: string; brand?: string}>> = {
  classic: [
    { category: 'Structure', spec: 'Fe 550 TMT Rebar', brand: 'Tata Tiscon / JSW Neo' },
    { category: 'Concrete', spec: 'M20 Grade RMC' },
    { category: 'Cement', spec: 'Grade 53 OPC / PPC', brand: 'Ultratech / ACC' },
    { category: 'Masonry', spec: 'Red Clay Bricks / AAC Blocks' },
    { category: 'Flooring', spec: '2×2 ft Vitrified Tiles' },
    { category: 'Plumbing', spec: 'Jaquar Essco / Parryware' },
    { category: 'Electrical', spec: 'Finolex FR Cables' },
    { category: 'Paint', spec: 'Asian Paints Apcolite' },
  ],
  luxury: [
    { category: 'Structure', spec: 'Fe 550D High-Ductility TMT', brand: 'Tata Tiscon SD / SAIL' },
    { category: 'Concrete', spec: 'M25 Grade RMC with SCC option' },
    { category: 'Masonry', spec: 'AAC Blocks (Thermal Insulating)' },
    { category: 'Flooring', spec: 'Italian Marble / 4×2 ft GVT Slabs' },
    { category: 'Main Door', spec: 'Burma Teak Solid + Designer Hardware' },
    { category: 'Plumbing', spec: 'Grohe / Kohler / Cera Premium' },
    { category: 'Electrical', spec: 'Havells Wires, Legrand Switches' },
    { category: 'Paint', spec: 'Asian Paints Royale / Berger Silk' },
  ],
  ultra: [
    { category: 'Structure', spec: 'High-Grade RCC Frame (Structural Sign-off)' },
    { category: 'Concrete', spec: 'M30 Grade + Self-Compacting Mix' },
    { category: 'Facade', spec: 'Double-Height Glazing / GRC Panels' },
    { category: 'Flooring', spec: 'Imported Italian Marble / Spanish Porcelain' },
    { category: 'Main Door', spec: 'Custom Pivot Entry + Biometric Lock' },
    { category: 'Plumbing', spec: 'Toto / Hansgrohe / Duravit (concealed)' },
    { category: 'Electrical', spec: 'Smart Home Automation, Legrand Arteor' },
    { category: 'Insulation', spec: 'Acoustic & Thermal Wall Insulation' },
  ],
};

// ── State ──────────────────────────────────────────────────────────────
const state = {
  perFloorArea: 1500,
  floor: 'G+1',
  pkg: 'luxury' as string,
  basement: false,
  basementArea: 400,
  compoundwall: false,
  compoundwallLength: 100,
  sump: false,
  facade: false,
  specsOpen: false,
};

// ── Utilities ──────────────────────────────────────────────────────────
function fmt(n: number): string {
  if (n < 100000) return `₹${n.toLocaleString('en-IN')}`;
  if (n < 10000000) return `₹${(n / 100000).toFixed(2)} L`;
  return `₹${(n / 10000000).toFixed(2)} Cr`;
}

// ── Calculation ────────────────────────────────────────────────────────
function recalculate() {
  const pkgData = PACKAGES[state.pkg as keyof typeof PACKAGES];
  const floorData = FLOOR_CONFIGS[state.floor] ?? FLOOR_CONFIGS['G+1'];

  // Total built-up area scaled by number of floors
  const totalBua = Math.round(state.perFloorArea * floorData.multiplier);

  const baseMin = Math.round(totalBua * pkgData.rateMin);
  const baseMax = Math.round(totalBua * pkgData.rateMax);

  let addons = 0;
  if (state.basement) addons += state.basementArea * ADDON_RATES.basement;
  if (state.compoundwall) addons += state.compoundwallLength * ADDON_RATES.compoundwall;
  if (state.sump) addons += ADDON_RATES.sump;
  if (state.facade) addons += totalBua * 0.30 * ADDON_RATES.facade;
  addons = Math.round(addons);

  const totalMin = baseMin + addons;
  const totalMax = baseMax + addons;
  const totalMid = Math.round((totalMin + totalMax) / 2);

  // Update total built-up area banners
  const elBuaDisplay = document.getElementById('total-bua-display');
  if (elBuaDisplay) elBuaDisplay.textContent = totalBua.toLocaleString('en-IN');

  const elBuaFormula = document.getElementById('total-bua-formula');
  if (elBuaFormula) {
    elBuaFormula.textContent = `${state.perFloorArea.toLocaleString('en-IN')} sq.ft × ${floorData.multiplier} floor multiplier`;
  }

  const elFloorDesc = document.getElementById('floor-desc-badge');
  if (elFloorDesc) elFloorDesc.textContent = floorData.desc;

  // Update DOM — results card
  const elTotal = document.getElementById('result-total');
  if (elTotal) elTotal.textContent = `${fmt(totalMin)} – ${fmt(totalMax)}`;

  const elBase = document.getElementById('result-base');
  if (elBase) elBase.textContent = `${fmt(baseMin)} – ${fmt(baseMax)}`;

  const elAddons = document.getElementById('result-addons');
  if (elAddons) elAddons.textContent = addons === 0 ? '—' : fmt(addons);

  const elLabel = document.getElementById('result-package-label');
  if (elLabel) elLabel.textContent = `${pkgData.name} Package`;

  const elBuaSummary = document.getElementById('result-bua-summary');
  if (elBuaSummary) {
    elBuaSummary.textContent = `${totalBua.toLocaleString('en-IN')} sq.ft total (${floorData.desc})`;
  }

  // Update breakdown bars
  document.querySelectorAll<HTMLElement>('.breakdown-item').forEach((item, i) => {
    const cat = BREAKDOWN[i];
    if (!cat) return;
    const amount = Math.round(totalMid * cat.pct / 100);
    const amtEl = item.querySelector<HTMLElement>('.breakdown-amount');
    const pctEl = item.querySelector<HTMLElement>('.breakdown-pct');
    const barEl = item.querySelector<HTMLElement>('[class*="bg-primary"]');
    if (amtEl) amtEl.textContent = fmt(amount);
    if (pctEl) pctEl.textContent = `${cat.pct}%`;
    if (barEl) barEl.style.width = `${cat.pct}%`;
  });

  // Update materials (scaled by total built-up area)
  const steelMt = (totalBua * MATERIAL_FACTORS.steel / 1000).toFixed(1);
  const cement = Math.round(totalBua * MATERIAL_FACTORS.cement).toLocaleString('en-IN');
  const sand = Math.round(totalBua * MATERIAL_FACTORS.sand).toLocaleString('en-IN');
  const bricks = Math.round(totalBua * MATERIAL_FACTORS.bricks).toLocaleString('en-IN');

  const matValues = [steelMt, cement, sand, bricks];
  document.querySelectorAll<HTMLElement>('.material-item').forEach((item, i) => {
    const valEl = item.querySelector<HTMLElement>('.material-value');
    if (valEl && matValues[i] !== undefined) valEl.textContent = matValues[i];
  });

  // Update CTA link
  const ctaBtn = document.getElementById('calc-cta-btn') as HTMLAnchorElement | null;
  if (ctaBtn) {
    const params = new URLSearchParams({
      package: state.pkg,
      floors: state.floor,
      perFloorArea: String(state.perFloorArea),
      totalBua: String(totalBua),
      budget: fmt(totalMin) + ' – ' + fmt(totalMax),
    });
    ctaBtn.href = `/contact?${params.toString()}`;
  }
}

// ── Update specs panel ─────────────────────────────────────────────────
function updateSpecsPanel() {
  const nameEl = document.getElementById('specs-package-name');
  const gridEl = document.getElementById('specs-grid');
  if (!nameEl || !gridEl) return;

  const specs = PACKAGE_SPECS[state.pkg] ?? [];
  nameEl.textContent = `${PACKAGES[state.pkg as keyof typeof PACKAGES]?.name} — Included Specifications`;
  gridEl.innerHTML = specs.map(s => `
    <div class="flex flex-col gap-0.5 p-2 rounded-lg bg-surface-container-low">
      <span class="text-[9px] font-bold uppercase tracking-wider text-outline">${s.category}</span>
      <span class="text-[11px] font-medium text-on-surface">${s.spec}</span>
      ${s.brand ? `<span class="text-[10px] text-primary font-semibold">${s.brand}</span>` : ''}
    </div>
  `).join('');
}

// ── Range input fill update ────────────────────────────────────────────
function updateRangeFill(el: HTMLInputElement) {
  const min = Number(el.min);
  const max = Number(el.max);
  const val = Number(el.value);
  const pct = ((val - min) / (max - min)) * 100;
  el.style.setProperty('--range-pct', `${pct}%`);
}

// ── Event wiring ───────────────────────────────────────────────────────
function initCalculator() {
  // Area Slider
  const areaSlider = document.getElementById('calc-area') as HTMLInputElement | null;
  const areaDisplay = document.getElementById('area-display');
  if (areaSlider && areaDisplay) {
    updateRangeFill(areaSlider);
    areaSlider.addEventListener('input', () => {
      state.perFloorArea = Number(areaSlider.value);
      areaDisplay.textContent = Number(areaSlider.value).toLocaleString('en-IN');
      updateRangeFill(areaSlider);
      recalculate();
    });
  }

  // Floor buttons
  document.querySelectorAll<HTMLButtonElement>('.floor-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.floor = btn.dataset.floor!;
      document.querySelectorAll<HTMLButtonElement>('.floor-btn').forEach(b => {
        const isActive = b.dataset.floor === state.floor;
        if (isActive) {
          b.className = 'floor-btn py-2.5 px-1 text-[11px] sm:text-xs font-bold rounded-xl border transition-all text-center bg-primary text-on-primary border-primary shadow-md ring-2 ring-primary/20';
        } else {
          b.className = 'floor-btn py-2.5 px-1 text-[11px] sm:text-xs font-bold rounded-xl border transition-all text-center bg-surface-container text-on-surface-variant border-outline-variant/30 hover:border-primary/50 hover:text-primary';
        }
      });
      recalculate();
    });
  });

  // Package buttons
  document.querySelectorAll<HTMLButtonElement>('.pkg-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.pkg = btn.dataset.package!;
      document.querySelectorAll<HTMLButtonElement>('.pkg-btn').forEach(b => {
        const isActive = b.dataset.package === state.pkg;
        if (isActive) {
          b.classList.add('border-primary', 'bg-primary/5', 'shadow-md', 'ring-2', 'ring-primary/20');
          b.classList.remove('border-outline-variant/30', 'bg-surface-container', 'hover:border-primary/40');
        } else {
          b.classList.remove('border-primary', 'bg-primary/5', 'shadow-md', 'ring-2', 'ring-primary/20');
          b.classList.add('border-outline-variant/30', 'bg-surface-container', 'hover:border-primary/40');
        }
      });
      updateSpecsPanel();
      recalculate();
    });
  });

  // Specs toggle
  const toggleBtn = document.getElementById('toggle-specs-btn');
  const specsTable = document.getElementById('specs-table');
  const specsIcon = document.getElementById('specs-icon');
  const specsBtnLabel = document.getElementById('specs-btn-label');
  if (toggleBtn && specsTable && specsIcon && specsBtnLabel) {
    toggleBtn.addEventListener('click', () => {
      state.specsOpen = !state.specsOpen;
      specsTable.classList.toggle('hidden', !state.specsOpen);
      specsIcon.textContent = state.specsOpen ? 'expand_less' : 'expand_more';
      specsBtnLabel.textContent = state.specsOpen ? 'Hide specifications' : 'View material specifications';
    });
  }

  // Add-on toggles
  document.querySelectorAll<HTMLInputElement>('.addon-toggle').forEach(chk => {
    chk.addEventListener('change', () => {
      const addon = chk.dataset.addon!;
      const isOn = chk.checked;

      if (addon === 'basement') {
        state.basement = isOn;
        const qtyEl = document.getElementById('basement-qty');
        if (qtyEl) qtyEl.classList.toggle('hidden', !isOn);
      } else if (addon === 'compoundwall') {
        state.compoundwall = isOn;
        const qtyEl = document.getElementById('compoundwall-qty');
        if (qtyEl) qtyEl.classList.toggle('hidden', !isOn);
      } else if (addon === 'sump') {
        state.sump = isOn;
      } else if (addon === 'facade') {
        state.facade = isOn;
      }
      recalculate();
    });
  });

  // Basement area input
  const basementAreaInput = document.getElementById('basement-area') as HTMLInputElement | null;
  if (basementAreaInput) {
    basementAreaInput.addEventListener('input', () => {
      state.basementArea = Number(basementAreaInput.value) || 400;
      recalculate();
    });
  }

  // Compound wall length input
  const cwLengthInput = document.getElementById('compoundwall-length') as HTMLInputElement | null;
  if (cwLengthInput) {
    cwLengthInput.addEventListener('input', () => {
      state.compoundwallLength = Number(cwLengthInput.value) || 100;
      recalculate();
    });
  }
}

initCalculator();
document.addEventListener('astro:page-load', initCalculator);
</script>
