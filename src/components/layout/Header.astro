---
const links = [
  { text: 'Home', href: '/' },
  { text: 'Services', href: '/services' },
  { text: 'Projects', href: '/projects' },
  { text: 'About', href: '/about' },
  { text: 'Process', href: '/process' },
];
---

<header class="bg-surface sticky top-0 z-50 border-b border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold text-primary tracking-tight">
          PAANYA EMPIRE
        </a>
      </div>
      
      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-8">
        {links.map(link => (
          <a 
            href={link.href} 
            class="text-label-md text-on-surface hover:text-primary transition-colors"
          >
            {link.text}
          </a>
        ))}
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a 
          href="/contact" 
          class="bg-primary-container text-on-primary text-label-md px-6 py-2.5 rounded-lg hover:bg-primary transition-colors"
        >
          Contact Us
        </a>
      </div>

      <!-- Mobile menu button (placeholder) -->
      <div class="md:hidden flex items-center">
        <button class="text-on-surface hover:text-primary">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
