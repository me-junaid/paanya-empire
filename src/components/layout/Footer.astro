---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface border-t border-outline-variant/30 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <div class="md:col-span-2">
        <a href="/" class="text-2xl font-bold text-primary tracking-tight">
          PAANYA EMPIRE
        </a>
        <p class="mt-4 text-on-surface-variant text-body-md max-w-sm">
          Premium turnkey construction and real estate services. Building trust, engineering excellence, and delivering luxury.
        </p>
      </div>

      <div>
        <h3 class="text-label-md font-bold text-on-surface tracking-wider uppercase mb-4">Explore</h3>
        <ul class="space-y-3">
          <li><a href="/projects" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">Projects</a></li>
          <li><a href="/services" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">Services</a></li>
          <li><a href="/process" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">Our Process</a></li>
          <li><a href="/about" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">About Us</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-label-md font-bold text-on-surface tracking-wider uppercase mb-4">Connect</h3>
        <ul class="space-y-3">
          <li><a href="/contact" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">Contact Us</a></li>
          <li><a href="/faq" class="text-body-md text-on-surface-variant hover:text-primary transition-colors">FAQ</a></li>
          <li class="pt-2">
            <a href="mailto:info@paanyaempire.com" class="text-body-md text-primary hover:underline">
              info@paanyaempire.com
            </a>
          </li>
        </ul>
      </div>

    </div>
    
    <div class="mt-12 pt-8 border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center">
      <p class="text-body-md text-on-surface-variant">
        &copy; {currentYear} Paanya Empire. All rights reserved.
      </p>
      <div class="mt-4 md:mt-0 space-x-4">
        <!-- Social links placeholder -->
      </div>
    </div>
  </div>
</footer>
