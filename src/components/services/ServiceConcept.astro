---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
}

const { title, subtitle, description, capabilities } = Astro.props;
---

<!-- 2. SERVICE CONCEPT & CAPABILITIES -->
<section class="w-full py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto flex flex-col gap-8">
  <div class="flex flex-col gap-2">
    <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
      {subtitle}
    </span>
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      {title}
    </h2>
    <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed max-w-3xl">
      {description}
    </p>
  </div>

  <!-- Capabilities Matrix -->
  {capabilities && capabilities.length > 0 && (
    <div class="flex flex-col gap-3 pt-2">
      <span class="text-xs font-bold uppercase tracking-widest text-outline">
        Integrated Capabilities & Deliverables
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {capabilities.map((cap) => (
          <div class="flex items-center gap-2.5 p-3.5 rounded-xl bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/40 shadow-xs transition-all">
            <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
            <span class="text-xs font-semibold text-on-surface">
              {cap}
            </span>
          </div>
        ))}
      </div>
    </div>
  )}
</section>
