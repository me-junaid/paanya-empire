---
import type { ServiceScope } from '../../types/service';

interface Props {
  scope: ServiceScope;
}

const { scope } = Astro.props;
---

<!-- 4. SERVICE SCOPE OF WORK -->
<section class="w-full py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto flex flex-col gap-10">
  <div class="flex flex-col gap-2">
    <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
      {scope.subtitle}
    </span>
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      {scope.title}
    </h2>
    <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
      {scope.description}
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {scope.stages.map((stage) => (
      <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between gap-5 hover:border-primary/40 hover:shadow-xs transition-all">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-lg bg-surface-container-highest text-primary font-headline font-bold text-xs flex items-center justify-center">
              {stage.number}
            </span>
          </div>
          
          <h3 class="font-headline text-base font-bold text-on-surface uppercase tracking-tight">
            {stage.title}
          </h3>
          
          <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
            {stage.description}
          </p>
        </div>
        
        <div class="flex flex-col gap-2 pt-3 border-t border-outline-variant/20">
          {stage.items.map((item) => (
            <div class="flex items-center gap-2 text-xs text-on-surface-variant">
              <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
