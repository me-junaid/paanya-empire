---
import type { ServiceProcessPhase } from '../../types/service';

interface Props {
  process: ServiceProcessPhase[];
}

const { process } = Astro.props;
---

<!-- 6. EXECUTION TIMELINE & PHASES -->
<section class="w-full py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto flex flex-col gap-10">
  <div class="flex flex-col gap-2">
    <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
      Milestone Protocol
    </span>
    <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-on-surface">
      The Paanya Execution Process
    </h2>
    <p class="text-sm sm:text-base text-on-surface-variant max-w-xl leading-relaxed">
      A transparent, milestone-driven workflow from initial feasibility and approvals to structural handover.
    </p>
  </div>
  
  <div class="flex flex-col gap-6 relative before:content-[''] before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-outline-variant/40 max-w-3xl">
    {process.map((phase) => (
      <div class="relative pl-8 sm:pl-10">
        <!-- Timeline dot -->
        <div class="absolute left-0 top-2 w-6 h-6 rounded-full bg-surface border-2 border-primary flex items-center justify-center z-10 shadow-xs">
          <div class="w-2 h-2 rounded-full bg-primary"></div>
        </div>
        
        <div class="bg-surface-container-lowest p-6 sm:p-7 rounded-2xl shadow-xs border border-outline-variant/30 hover:border-primary/40 transition-all">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="text-xs font-bold tracking-widest text-primary uppercase">{phase.phase}</span>
            {phase.duration && (
              <span class="text-[10px] px-2.5 py-1 rounded-md bg-surface-container text-secondary font-semibold uppercase tracking-wider">
                {phase.duration}
              </span>
            )}
          </div>
          
          <h3 class="font-headline text-base sm:text-lg font-bold text-on-surface uppercase tracking-tight mb-2">{phase.title}</h3>
          
          <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
            {phase.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
