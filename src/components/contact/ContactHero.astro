<!-- 1. CONTACT PAGE HERO -->
<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6 flex flex-col gap-6">
  <div class="flex items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block animate-pulse"></span>
    <span class="font-headline text-[11px] sm:text-xs font-bold tracking-[0.2em] uppercase text-primary">
      CONTACT PAANYA EMPIRE
