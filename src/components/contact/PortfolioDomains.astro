<!-- 7. WHAT ARE YOU BUILDING? (PROJECT TYPES) -->
<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col gap-6">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[10px] sm:text-[11px] font-bold tracking-[0.18em] uppercase text-primary">
        PORTFOLIO DOMAINS
      </span>
      <div class="h-0.5 w-6 bg-primary/30"></div>
    </div>
    <h2 class="font-headline text-xl sm:text-2xl font-bold uppercase tracking-tight text-on-surface">
      WHAT ARE YOU BUILDING?
    </h2>
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Explore archetypes to understand how Paanya Empire executes precision engineering across various scales.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {archetypes.map((card) => (
      <a 
        href={card.link}
        class="p-4 rounded-2xl bg-surface-container flex flex-col gap-3.5 shadow-xs border border-outline-variant/30 hover:border-primary/40 hover:-translate-y-1 transition-all group"
      >
        <div class="h-36 w-full rounded-xl overflow-hidden relative bg-surface-container-high">
          <div 
            class="w-full h-full bg-cover bg-center transition-transform duration-700 group-hover:scale-110" 
            role="img" 
            aria-label={card.title} 
            style={`background-image: url('${card.image}')`}
          >
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/60 via-transparent to-transparent"></div>
        </div>
        <div class="flex flex-col gap-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase text-on-surface group-hover:text-primary transition-colors">
              {card.title}
            </span>
            <span class="material-symbols-outlined text-[16px] text-outline group-hover:text-primary group-hover:translate-x-1 transition-all">
              arrow_forward
            </span>
          </div>
          <p class="text-[11px] text-on-surface-variant leading-relaxed font-light">
            {card.desc}
          </p>
        </div>
      </a>
    ))}
  </div>
</section>
