---
const steps = [
  {
    number: '01',
    title: 'YOU REACH OUT',
    desc: 'Tell us about your project through the digital form, a quick phone call, direct email, or WhatsApp concierge.',
    icon: 'mail',
  },
  {
    number: '02',
    title: 'WE UNDERSTAND',
    desc: 'We learn about your plot, spatial requirements, lifestyle preferences, budget boundaries, and targeted timeline.',
    icon: 'psychology',
  },
  {
    number: '03',
    title: 'WE DISCUSS',
    desc: 'We review architectural feasibility, design directions, and realistic project milestones transparently.',
    icon: 'forum',
  },
  {
    number: '04',
    title: 'WE MOVE FORWARD',
    desc: 'If Paanya Empire is the right fit, we sign an integrated master agreement and commence schematic design.',
    icon: 'handshake',
  },
];
---

<!-- 5. WHAT HAPPENS AFTER YOU CONTACT US -->
<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col gap-6">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[10px] sm:text-[11px] font-bold tracking-[0.18em] uppercase text-primary">
        WHAT HAPPENS NEXT
      </span>
      <div class="h-0.5 w-6 bg-primary/30"></div>
    </div>
    <h2 class="font-headline text-xl sm:text-2xl font-bold uppercase tracking-tight text-on-surface">
      A SIMPLE FIRST STEP. A CLEARER NEXT STEP.
    </h2>
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Our structured onboarding ensures seamless execution without ambiguity or high-pressure sales tactics.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {steps.map((step) => (
      <div class="p-5 rounded-2xl bg-surface-container flex flex-col gap-3 shadow-xs border border-outline-variant/30 hover:border-primary/40 transition-all group">
        <div class="flex items-center justify-between">
          <span class="text-xl font-extrabold text-primary font-headline group-hover:scale-110 transition-transform">
            {step.number}
          </span>
          <div class="w-8 h-8 rounded-lg bg-surface-container-high text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-[18px]">{step.icon}</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <span class="text-xs font-bold uppercase tracking-wider text-on-surface">
            {step.title}
          </span>
          <p class="text-[11px] sm:text-xs text-on-surface-variant leading-relaxed font-light">
            {step.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
