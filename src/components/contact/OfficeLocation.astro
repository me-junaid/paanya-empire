---
---

<!-- 4. LOCATION & CONSULTATION DESK -->
<section class="w-full bg-surface-container-low border-y border-outline-variant/20 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto flex flex-col gap-6">
    
    <div class="flex flex-col gap-1.5">
      <div class="flex items-center gap-2">
        <span class="font-headline text-[10px] sm:text-[11px] font-bold tracking-[0.18em] uppercase text-primary">
          STUDIO &amp; HEADQUARTERS
        </span>
        <div class="h-0.5 w-6 bg-primary/30"></div>
      </div>
      <h2 class="font-headline text-xl sm:text-2xl font-bold uppercase tracking-tight text-on-surface">
        VISIT PAANYA EMPIRE
      </h2>
      <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
        Schedule an in-person review with our senior partners and material curators at our flagship design bureau.
      </p>
    </div>

    <!-- Map & Physical Address Card -->
    <div class="flex flex-col lg:flex-row rounded-2xl overflow-hidden bg-surface-container shadow-xs border border-outline-variant/30">
      
      <!-- Studio Location Image -->
      <div class="w-full lg:w-1/2 h-56 lg:h-auto min-h-[240px] relative overflow-hidden bg-surface-container-high">
        <div 
          class="w-full h-full bg-cover bg-center transition-transform duration-700 hover:scale-105" 
          role="img" 
          aria-label="Paanya Empire Central Design Bureau in Kozhikode" 
          style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD9-gWI8yIwFSLQMXcDiLIZYbUwyNuQaYqMm0ft8SnjP73Vgsf21pTYdn_7cJ3PbQ18Hp9n3xp7_y_9G66bD68bhut4jnVYZUKJWTk_adJOMiiH7tU9zUzwtchXxj_XBsYPVmMo8975KGwl5vRVOLrMZ22ZsvhnpHDaAQo8VG7NJLUFpPEWMWh8zlPIPv69mPw40HfGNZik78RPgCv9YcaX_Eoitrt24LohUJ_YjtIW8fFRqyWhlOFxHA')"
        >
        </div>
        <div class="absolute top-4 left-4 bg-inverse-surface/85 backdrop-blur-md px-3 py-1.5 rounded-lg text-[10px] font-bold tracking-wider uppercase text-inverse-on-surface flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Flagship Atelier</span>
        </div>
      </div>

      <!-- Address Details & Hours -->
      <div class="w-full lg:w-1/2 p-6 sm:p-8 flex flex-col justify-between gap-6">
        
        <div class="flex items-start justify-between gap-4">
          <div class="flex flex-col gap-1">
            <span class="text-[10px] uppercase tracking-wider font-bold text-primary font-headline">
              Central Design Bureau
            </span>
            <h3 class="text-base sm:text-lg font-extrabold text-on-surface">
              Metropolis Tower, Ste 400
            </h3>
            <p class="text-xs text-on-surface-variant font-light leading-relaxed">
              Beach Road / Commercial Promenade, Kozhikode, Kerala 673032
            </p>
          </div>

          <a 
            href="https://maps.google.com/?q=Kozhikode,Kerala" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Open location in Google Maps"
            class="p-3 rounded-xl bg-primary text-on-primary hover:bg-primary-container transition-colors shrink-0 shadow-xs flex items-center justify-center"
          >
            <span class="material-symbols-outlined text-[20px]">near_me</span>
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <!-- Office Hours -->
          <div class="p-4 rounded-xl bg-surface-container-lowest flex items-center gap-3.5 border border-outline-variant/30">
            <div class="w-9 h-9 rounded-lg bg-surface-container-low text-secondary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">schedule</span>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface">Studio Timings</span>
              <span class="text-xs text-on-surface-variant font-medium">
                Monday – Saturday: 9:00 AM – 6:30 PM <span class="text-primary font-semibold">(By Appointment)</span>
              </span>
            </div>
          </div>

          <!-- Parking & Access Notice -->
          <div class="p-4 rounded-xl bg-surface-container-lowest flex items-center gap-3.5 border border-outline-variant/30">
            <div class="w-9 h-9 rounded-lg bg-surface-container-low text-secondary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">local_parking</span>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface">Client Valet</span>
              <span class="text-xs text-on-surface-variant font-medium">
                Reserved underground executive parking & private elevator foyer.
              </span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
