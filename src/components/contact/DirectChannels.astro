---
---

<!-- 3. DIRECT CONTACT OPTIONS -->
<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col gap-6">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span class="font-headline text-[10px] sm:text-[11px] font-bold tracking-[0.18em] uppercase text-primary">
        PREFER TO TALK DIRECTLY?
      </span>
      <div class="h-0.5 w-6 bg-primary/30"></div>
    </div>
    <h2 class="font-headline text-xl sm:text-2xl font-bold uppercase tracking-tight text-on-surface">
      DIRECT CONCIERGE CHANNELS
    </h2>
    <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl">
      Speak directly with our senior architectural advisory team for immediate consultations or active site appointment scheduling.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Call -->
    <div class="p-5 rounded-2xl bg-surface-container flex items-center justify-between gap-4 shadow-xs border border-outline-variant/30 hover:border-primary/40 transition-colors">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-primary-fixed text-on-primary-fixed flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[24px]">call</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase font-bold tracking-wider text-outline">Phone Line</span>
          <span class="text-sm font-bold text-on-surface">+91 93866 66199</span>
          <span class="text-[10px] text-on-surface-variant font-medium">Direct Advisory</span>
        </div>
      </div>
      <a 
        href="tel:+919386666199" 
        class="px-3.5 py-2.5 rounded-xl bg-primary text-on-primary text-[11px] font-bold uppercase tracking-wider shrink-0 hover:bg-primary-container transition-colors shadow-xs"
      >
        CALL NOW
      </a>
    </div>

    <!-- WhatsApp -->
    <div class="p-5 rounded-2xl bg-surface-container flex items-center justify-between gap-4 shadow-xs border border-outline-variant/30 hover:border-primary/40 transition-colors">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[24px]">chat</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase font-bold tracking-wider text-outline">WhatsApp Desk</span>
          <span class="text-sm font-bold text-on-surface">+91 93866 66199</span>
          <span class="text-[10px] text-on-surface-variant font-medium">Quick Blueprint Drop</span>
        </div>
      </div>
      <a 
        href="https://wa.me/919386666199" 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-3.5 py-2.5 rounded-xl bg-inverse-surface text-inverse-on-surface text-[11px] font-bold uppercase tracking-wider shrink-0 hover:opacity-90 transition-opacity shadow-xs"
      >
        CHAT NOW
      </a>
    </div>

    <!-- Email -->
    <div class="p-5 rounded-2xl bg-surface-container flex items-center justify-between gap-4 shadow-xs border border-outline-variant/30 hover:border-primary/40 transition-colors">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[24px]">mail</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase font-bold tracking-wider text-outline">Direct Email</span>
          <span class="text-sm font-bold text-on-surface">inquiries@paanya.com</span>
          <span class="text-[10px] text-on-surface-variant font-medium">Formal Submissions</span>
        </div>
      </div>
      <a 
        href="mailto:inquiries@paanya.com" 
        class="px-3.5 py-2.5 rounded-xl bg-surface-container-highest text-on-surface text-[11px] font-bold uppercase tracking-wider shrink-0 hover:bg-surface-container-high transition-colors shadow-xs"
      >
        SEND EMAIL
      </a>
    </div>
  </div>
</section>
