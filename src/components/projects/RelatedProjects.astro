---
import type { Project } from '../../types/project';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{projects && projects.length > 0 && (
  <section class="w-full py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
          Discover More Landmarks
        </span>
        <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-on-surface">
          MORE PROJECTS BY PAANYA EMPIRE
        </h2>
      </div>
      <a 
        href="/projects"
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase text-primary tracking-wider hover:underline group"
      >
        <span>All Projects</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
)}
