---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const gallery = project.gallery;
---

{gallery && gallery.length > 0 && (
  <section class="w-full bg-surface-container-low py-16 px-4 sm:px-6 lg:px-8 border-y border-outline-variant/20">
    <div class="max-w-6xl mx-auto flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
            Visual Architecture
          </span>
          <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-on-surface">
            IMMERSIVE PROJECT GALLERY
          </h2>
        </div>
        <span class="text-xs text-on-surface-variant font-medium">
          {gallery.length} Selected High-Fidelity Perspectives
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        {gallery.map((item, index) => {
          let colClass = 'md:col-span-6 h-64 sm:h-72';
          if (item.span === 'large') {
            colClass = 'md:col-span-7 h-72 sm:h-80';
          } else if (item.span === 'split') {
            colClass = 'md:col-span-5 h-72 sm:h-80';
          }

          return (
            <div class={`${colClass} relative rounded-2xl overflow-hidden group border border-outline-variant/20 shadow-xs bg-surface-container`}>
              <img 
                src={item.url} 
                alt={item.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex items-end justify-between p-5">
                <div>
                  <span class="text-[10px] uppercase font-bold tracking-widest text-secondary-fixed">
                    {item.categoryLabel}
                  </span>
                  <p class="text-xs sm:text-sm font-semibold text-on-primary mt-0.5">
                    {item.caption}
                  </p>
                </div>
                <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-on-primary opacity-80 group-hover:opacity-100 transition-opacity">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
