---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<!-- 1. HERO SECTION -->
<section class="relative w-full overflow-hidden bg-on-surface text-on-primary">
  <div class="relative w-full min-h-[580px] sm:min-h-[660px] lg:min-h-[720px] flex items-end">
    <!-- Background Hero Image -->
    <div 
      class="absolute inset-0 z-0 bg-cover bg-center transition-transform duration-1000 scale-105"
      style={`background-image: url('${project.heroImage}');`}
    ></div>
    
    <!-- Architectural Gradient Scrim -->
    <div class="absolute inset-0 z-10 bg-gradient-to-t from-[#071A33] via-[#071A33]/70 to-transparent"></div>
    <div class="absolute inset-0 z-10 bg-gradient-to-r from-[#071A33]/85 via-[#071A33]/40 to-transparent"></div>

    <!-- Hero Content -->
    <div class="relative z-20 w-full px-4 sm:px-6 lg:px-8 py-16 max-w-6xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest/15 backdrop-blur-md mb-4">
        <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
        <span class="font-headline tracking-[0.2em] text-[11px] font-bold uppercase text-primary-fixed">
          PROJECT / {project.category}
        </span>
      </div>

      <h1 class="font-headline text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-on-primary uppercase leading-tight mb-4 max-w-4xl">
        {project.title}
      </h1>

      <!-- Metadata Strip -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm font-medium text-secondary-fixed mb-4">
        <span class="tracking-wider uppercase">{project.location}</span>
        <span class="text-outline-variant/60">•</span>
        <span class="tracking-wider uppercase">{project.area}</span>
        <span class="text-outline-variant/60">•</span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-lowest/15 backdrop-blur-md text-primary-fixed font-semibold tracking-wide uppercase text-[11px]">
          <svg class="w-3.5 h-3.5 text-primary-fixed" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          {project.status}
        </span>
      </div>

      <p class="text-sm sm:text-base text-surface-container-low max-w-2xl font-light leading-relaxed mb-8">
        {project.description}
      </p>

      <!-- Interaction Bar & Scroll Cue -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a 
          href="#vision"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-on-primary text-xs font-semibold uppercase tracking-wider shadow-lg hover:bg-primary-container transition-all"
        >
          <span>Explore Case Study</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a 
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface-container-lowest/15 backdrop-blur-md text-on-primary text-xs font-semibold uppercase tracking-wider hover:bg-surface-container-lowest/25 transition-all"
        >
          <span>Inquire Custom Build</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PHILOSOPHICAL BANNER -->
<section class="w-full bg-[#071A33] text-on-primary py-4 px-4 sm:px-6 lg:px-8 border-t border-b border-outline-variant/10">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-primary-container shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <span class="font-headline uppercase tracking-widest text-[11px] font-semibold text-primary-fixed">
        "WE DON'T JUST SHOW WHAT WE BUILT. WE SHOW HOW WE BUILT IT."
      </span>
    </div>
    <div class="flex items-center gap-4 sm:gap-6 text-[11px] text-outline-variant">
      <span>Turnkey Delivery</span>
      <span>•</span>
      <span>Full-Scope EPC</span>
      <span>•</span>
      <span>Zero-Defect Standard</span>
    </div>
  </div>
</section>
