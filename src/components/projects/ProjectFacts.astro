---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const brief = project.architecturalBrief;
---

<section class="w-full px-4 sm:px-6 lg:px-8 py-16 max-w-6xl mx-auto" id="vision">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
    
    <!-- Narrative Left Column -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      <div class="flex items-center gap-2">
        <span class="w-6 h-0.5 bg-primary"></span>
        <span class="text-[11px] font-bold uppercase tracking-widest text-primary">
          {brief?.tagline || 'Architectural Brief & Orientation'}
        </span>
      </div>

      <h2 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-on-surface leading-tight">
        {brief?.headline || `Engineered for Precision: ${project.title}`}
      </h2>

      {brief?.paragraphs ? (
        brief.paragraphs.map((p) => (
          <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed">
            {p}
          </p>
        ))
      ) : (
        <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed">
          {project.summary}
        </p>
      )}

      <!-- Micro Impact Highlights -->
      {brief?.highlights && brief.highlights.length > 0 && (
        <div class="grid grid-cols-3 gap-3 pt-4">
          {brief.highlights.map((item) => (
            <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 flex flex-col">
              <span class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider">
                {item.label}
              </span>
              <span class="font-headline text-base sm:text-lg font-extrabold text-primary mt-1">
                {item.value}
              </span>
              <span class="text-[10px] text-outline mt-0.5">
                {item.detail}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Right Metadata Specifications Card -->
    <div class="lg:col-span-5 w-full">
      <div class="rounded-2xl bg-surface-container p-6 sm:p-8 border border-outline-variant/30 shadow-xs flex flex-col gap-5">
        <div class="flex items-center justify-between border-b border-outline-variant/30 pb-4">
          <span class="font-headline text-xs font-bold uppercase tracking-widest text-on-surface">
            Project Specifications
          </span>
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </div>

        <div class="flex flex-col gap-3 text-xs">
          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Project Type</span>
            <span class="font-semibold text-on-surface">{project.category}</span>
          </div>

          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Location</span>
            <span class="font-semibold text-on-surface">{project.location}</span>
          </div>

          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Status</span>
            <span class="inline-flex items-center gap-1.5 font-semibold text-primary">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              {project.status}
            </span>
          </div>

          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Built-up Area</span>
            <span class="font-semibold text-on-surface">{project.area}</span>
          </div>

          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Execution Scope</span>
            <span class="font-semibold text-on-surface text-right">{project.executionScope}</span>
          </div>

          <div class="flex justify-between items-center py-2.5 px-3 rounded-lg bg-surface-container-lowest border border-outline-variant/20">
            <span class="text-on-surface-variant font-medium">Timeline Duration</span>
            <span class="font-semibold text-on-surface">{project.timelineDuration}</span>
          </div>
        </div>

        {project.guarantee && (
          <div class="p-3.5 rounded-xl bg-primary-fixed/20 border border-primary/20 text-on-surface text-xs leading-relaxed flex gap-3 items-start">
            <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[11px] font-medium text-on-surface-variant">{project.guarantee}</span>
          </div>
        )}
      </div>
    </div>

  </div>
</section>
