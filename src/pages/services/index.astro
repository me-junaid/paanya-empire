---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/home/CTA.astro';
import { getServices } from '../../lib/services';

const services = await getServices();
const flagshipService = services.find((s) => s.isFlagship) || services[0];
const otherServices = services.filter((s) => s.id !== flagshipService.id);
---

<BaseLayout 
  title="Our Services — Paanya Empire | Turnkey Construction & Architectural Design" 
  description="Explore comprehensive architectural design, turnkey construction, luxury interiors, and structural engineering services by Paanya Empire."
>
  <!-- 1. PAGE HERO -->
  <section class="relative w-full overflow-hidden bg-on-surface text-on-primary min-h-[520px] sm:min-h-[580px] flex flex-col justify-end px-4 sm:px-6 lg:px-8 py-16">
    <!-- Hero Background with Scrim -->
    <div 
      class="absolute inset-0 z-0 bg-cover bg-center"
      style="background-image: url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80');"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-[#071A33] via-[#071A33]/75 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#071A33]/90 via-[#071A33]/40 to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col gap-4 max-w-2xl mx-auto w-full">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest/15 backdrop-blur-md self-start text-[11px] tracking-[0.2em] font-medium text-primary-fixed uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-container animate-pulse"></span>
        Our Services
      </div>
      
      <h1 class="font-headline text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-[1.1] text-on-primary">
        Everything your project needs.<br />
        <span class="text-secondary-fixed">Under one roof.</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-surface-container-high leading-relaxed font-normal max-w-lg">
        From architectural planning and structural engineering to luxury interiors and final turnkey handover, Paanya Empire provides harmonized, singular solutions for elite properties.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a 
          href="/contact"
          class="inline-flex items-center justify-center h-12 px-6 rounded-xl bg-primary text-on-primary text-xs font-semibold uppercase tracking-wider shadow-lg hover:bg-primary-container transition-colors"
        >
          Start Your Project
        </a>
        <a 
          href="/projects"
          class="inline-flex items-center justify-center h-12 px-6 rounded-xl bg-surface-container-lowest/15 backdrop-blur-md text-on-primary text-xs font-semibold uppercase tracking-wider hover:bg-surface-container-lowest/25 transition-colors"
        >
          View Our Projects
        </a>
      </div>
    </div>
  </section>

  <!-- 2. SERVICES INTRODUCTION & LIFECYCLE PROGRESSION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col gap-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 flex flex-col gap-2">
        <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
          What We Do
        </span>
        <h2 class="font-headline text-2xl sm:text-3xl font-bold uppercase tracking-tight text-on-surface">
          From The First Drawing To The Final Detail.
        </h2>
        <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
          Every construction project involves multiple critical disciplines. Our integrated studio model coordinates master planning, high-tolerance engineering, fine woodwork, and MEP so your vision transfers without dilution or logistical friction.
        </p>
      </div>

      <!-- 4-Step Visual Progression Grid -->
      <div class="lg:col-span-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          { num: '01', title: 'Design', desc: 'Concept & spatial flow' },
          { num: '02', title: 'Plan', desc: 'Engineering & permits' },
          { num: '03', title: 'Build', desc: 'Precision execution' },
          { num: '04', title: 'Finish', desc: 'Interiors & handover' }
        ].map((step) => (
          <div class="flex flex-col p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:border-primary/40 transition-colors">
            <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-[10px] font-bold flex items-center justify-center mb-2">
              {step.num}
            </span>
            <span class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface">
              {step.title}
            </span>
            <span class="text-[10px] text-on-surface-variant mt-1 leading-normal">
              {step.desc}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FLAGSHIP SPOTLIGHT (Turnkey Construction) -->
  {flagshipService && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="relative w-full rounded-2xl overflow-hidden bg-[#071A33] text-on-primary shadow-lg border border-outline-variant/30 flex flex-col lg:flex-row">
        <!-- Spotlight Media -->
        <div class="relative w-full lg:w-3/5 min-h-[340px] sm:min-h-[420px] bg-cover bg-center overflow-hidden group">
          <img 
            src={flagshipService.listingImage} 
            alt={flagshipService.title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#071A33] via-[#071A33]/40 to-transparent"></div>
          
          <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-[10px] font-bold uppercase tracking-wider text-primary">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            Flagship Offering · All-Inclusive
          </div>

          <div class="absolute bottom-4 left-4 right-4 text-on-primary">
            <span class="text-[10px] font-semibold tracking-widest uppercase text-secondary-fixed">
              One Team · End-to-End Governance
            </span>
            <h3 class="font-headline text-2xl sm:text-3xl font-bold uppercase tracking-tight text-on-primary mt-1">
              {flagshipService.title}
            </h3>
          </div>
        </div>

        <!-- Spotlight Content -->
        <div class="p-6 sm:p-8 flex flex-col justify-between gap-6 bg-[#092244] lg:w-2/5">
          <div class="flex flex-col gap-3">
            <span class="text-[10px] font-bold uppercase tracking-widest text-primary-fixed">
              Zero Contractor Handoffs
            </span>
            <p class="text-xs sm:text-sm text-surface-container-high leading-relaxed">
              {flagshipService.shortDescription}
            </p>

            <div class="flex flex-col gap-2 pt-2 border-t border-white/10">
              <span class="text-[10px] uppercase font-bold tracking-widest text-secondary-fixed">
                Complete Project Journey
              </span>
              <div class="flex flex-wrap gap-1.5">
                {['Design', 'Approvals', 'Construction', 'MEP', 'Interiors', 'Handover'].map((stage) => (
                  <span class="px-2.5 py-1 rounded-md bg-[#13305a] text-[10px] font-semibold text-primary-fixed uppercase tracking-wider">
                    {stage}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <a 
            href={`/services/${flagshipService.slug}`}
            class="inline-flex items-center justify-between w-full h-12 px-5 rounded-xl bg-primary text-on-primary text-xs font-semibold tracking-wider uppercase hover:bg-primary-container transition-colors shadow-xs"
          >
            <span>Explore {flagshipService.title}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 4. CORE SERVICES GRID -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-outline-variant/30 pb-4">
      <h2 class="font-headline text-lg sm:text-xl font-bold tracking-tight uppercase text-on-surface">
        Specialized Disciplines
      </h2>
      <span class="text-xs font-semibold uppercase tracking-wider text-primary">
        {otherServices.length} Core Services
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {otherServices.map((service, index) => {
        const numStr = (index + 1).toString().padStart(2, '0');
        return (
          <div class="flex flex-col rounded-2xl overflow-hidden bg-surface-container-lowest shadow-sm border border-outline-variant/30 hover:border-primary/40 hover:shadow-md transition-all group">
            <!-- Service Image -->
            <div class="relative w-full h-64 overflow-hidden bg-cover bg-center">
              <img 
                src={service.listingImage} 
                alt={service.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              
              <div class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-[9px] font-bold uppercase tracking-wider text-secondary">
                {numStr} / {service.overview.subtitle}
              </div>

              <div class="absolute bottom-3 left-4 right-4 text-on-primary">
                <h3 class="font-headline text-xl font-bold uppercase tracking-tight text-on-primary">
                  {service.title}
                </h3>
              </div>
            </div>

            <!-- Service Body -->
            <div class="p-6 flex flex-col flex-1 justify-between gap-5">
              <div class="flex flex-col gap-3">
                <h4 class="font-headline text-base font-bold uppercase text-on-surface tracking-tight">
                  {service.overview.title}
                </h4>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                  {service.shortDescription}
                </p>

                <div class="flex flex-wrap gap-1.5 pt-2">
                  {service.overview.capabilities.slice(0, 6).map((cap) => (
                    <span class="px-2.5 py-1 rounded-md bg-surface-container text-[10px] font-semibold text-secondary uppercase tracking-wider">
                      {cap}
                    </span>
                  ))}
                  {service.overview.capabilities.length > 6 && (
                    <span class="px-2.5 py-1 rounded-md bg-surface-container text-[10px] font-semibold text-secondary uppercase tracking-wider">
                      +{service.overview.capabilities.length - 6} more
                    </span>
                  )}
                </div>
              </div>

              <a 
                href={`/services/${service.slug}`}
                class="inline-flex items-center justify-between w-full h-11 px-4 rounded-xl bg-surface-container hover:bg-primary hover:text-on-primary text-on-surface text-xs font-semibold tracking-wider uppercase transition-colors"
              >
                <span>Explore {service.title}</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 5. ENGINEERING GOVERNANCE / PHILOSOPHY BANNER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="p-8 sm:p-12 rounded-3xl bg-surface-container-low border border-outline-variant/30 flex flex-col md:flex-row gap-8 items-start md:items-center justify-between">
      <div class="flex flex-col gap-2 max-w-2xl">
        <span class="font-headline text-[11px] font-bold tracking-[0.2em] uppercase text-primary">
          Execution Governance
        </span>
        <h2 class="font-headline text-2xl sm:text-3xl font-bold uppercase tracking-tight text-on-surface">
          Engineered For Certainty. Built For Generations.
        </h2>
        <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
          Our integrated turnkey protocol guarantees structural integrity, transparent cost tracking, and relentless on-site supervision throughout every milestone.
        </p>
      </div>
      <a 
        href="/process"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-on-surface text-surface text-xs font-semibold uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-colors whitespace-nowrap shrink-0"
      >
        Explore Our Process
      </a>
    </div>
  </section>

  <!-- 6. GLOBAL UNIFIED CTA -->
  <CTA />
</BaseLayout>
