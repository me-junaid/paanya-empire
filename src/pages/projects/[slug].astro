---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/projects/ProjectHero.astro';
import ProjectFacts from '../../components/projects/ProjectFacts.astro';
import ProjectNarrative from '../../components/projects/ProjectNarrative.astro';
import ProjectGallery from '../../components/projects/ProjectGallery.astro';
import ProjectScope from '../../components/projects/ProjectScope.astro';
import ProjectEngineering from '../../components/projects/ProjectEngineering.astro';
import RelatedProjects from '../../components/projects/RelatedProjects.astro';
import CTA from '../../components/home/CTA.astro';
import { getProjectBySlug, getRelatedProjects } from '../../lib/projects';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/projects');
}

const project = await getProjectBySlug(slug);

if (!project) {
  Astro.response.status = 404;
}

const relatedProjects = project ? await getRelatedProjects(project.slug, project.categorySlug, 3) : [];
---

{project ? (
  <BaseLayout 
    title={`${project.title} — Paanya Empire Project Case Study`}
    description={project.summary}
  >
    <main class="flex-1 flex flex-col w-full bg-surface">
      <!-- 1. Hero -->
      <ProjectHero project={project} />

      <!-- 2. Facts & Brief -->
      <ProjectFacts project={project} />

      <!-- 3. Narrative & Philosophy -->
      <ProjectNarrative project={project} />

      <!-- 4. Immersive Gallery -->
      <ProjectGallery project={project} />

      <!-- 5. Scope & Journey -->
      <ProjectScope project={project} />

      <!-- 6. Engineering & QA -->
      <ProjectEngineering project={project} />

      <!-- 7. Related Projects -->
      <RelatedProjects projects={relatedProjects} />

      <!-- 8. Final CTA -->
      <CTA />
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Project Not Found — Paanya Empire">
    <div class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-24 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2">404 Error</span>
      <h1 class="font-headline text-3xl sm:text-4xl font-extrabold text-on-surface mb-4">
        Project Case Study Not Found
      </h1>
      <p class="text-sm text-on-surface-variant max-w-md mb-8">
        The requested project case study does not exist or may have been relocated.
      </p>
      <a 
        href="/projects"
        class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-primary text-on-primary text-xs font-semibold uppercase tracking-wider hover:bg-primary-container transition-colors"
      >
        Return to Projects Showcase
      </a>
    </div>
  </BaseLayout>
)}
